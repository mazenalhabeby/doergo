{
  "name": "@hbcfield/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist-esm/client.js",
      "require": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist-esm/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist-esm/constants/index.js",
      "require": "./dist/constants/index.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "import": "./dist-esm/design/index.js",
      "require": "./dist/design/index.js"
    },
    "./design/tailwind-preset": {
      "types": "./dist/design/tailwind-preset.d.ts",
      "import": "./dist-esm/design/tailwind-preset.js",
      "require": "./dist/design/tailwind-preset.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist-esm/prisma/index.js",
      "require": "./dist/prisma/index.js"
    },
    "./microservices": {
      "types": "./dist/microservices/index.d.ts",
      "import": "./dist-esm/microservices/index.js",
      "require": "./dist/microservices/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist-esm/api/index.js",
      "require": "./dist/api/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist-esm/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist-esm/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist-esm/documents/index.js",
      "require": "./dist/documents/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist-esm/storage/index.js",
      "require": "./dist/storage/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ],
      "constants": [
        "./dist/constants/index.d.ts"
      ],
      "design": [
        "./dist/design/index.d.ts"
      ],
      "design/tailwind-preset": [
        "./dist/design/tailwind-preset.d.ts"
      ],
      "prisma": [
        "./dist/prisma/index.d.ts"
      ],
      "microservices": [
        "./dist/microservices/index.d.ts"
      ],
      "api": [
        "./dist/api/index.d.ts"
      ],
      "components": [
        "./dist/components/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ],
      "documents": [
        "./dist/documents/index.d.ts"
      ],
      "storage": [
        "./dist/storage/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist dist-esm",
    "build:esm": "tsc -p tsconfig.esm.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@prisma/client": "^6.3.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@prisma/client": "^6.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "react": "^18.0.0 || ^19.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rxjs": "^7.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}
