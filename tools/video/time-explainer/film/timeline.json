     "end": 18.265,
     "wordStarts": [
      13.876,
      14.143,
      14.654,
      15.002,
      15.409,
      16.407,
      16.593,
      16.953,
      17.092,
      17.406,
      17.58,
      17.835
     ]
    },
    {
