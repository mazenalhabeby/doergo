{
 "chapters": [
  {
   "id": "intro",
   "start": 0.4,
   "end": 31.843,
   "phrases": [
    {
     "text": "Every minute you work in HBCField is measured by two clocks.",
     "start": 0.4,
     "end": 4.15,
     "wordStarts": [
      0.4,
      0.76,
      1.05,
      1.189,
      1.41,
      1.538,
      2.409,
      2.583,
      2.966,
      3.175,
      3.465
     ]
    },
    {
     "text": "The first is your shift. It starts when you clock in, and stops when you clock out. That is your working day.",
     "start": 5.141,
     "end": 12.885,
     "wordStarts": [
      5.141,
      5.315,
      5.652,
      5.803,
      6.012,
      6.987,
      7.196,
      7.591,
      7.765,
      7.904,
