  {
   "id": "gate",
   "start": 65.707,
   "end": 106.252,
   "phrases": [
    {
     "text": "A job can only start when the person doing it is clocked in. In the office, out on the road, on the phone and on the web.",
     "start": 65.707,
     "end": 75.378,
     "wordStarts": [
      65.707,
      65.939,
      66.311,
      66.543,
      66.926,
