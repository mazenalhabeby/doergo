      110.664,
      110.942,
      111.059
     ]
    },
    {
     "text": "Accepting a job, the evening before, counts nothing.",
     "start": 112.479,
     "end": 116.113,
     "wordStarts": [
      112.479,
      113.037,
      113.118,
      113.466,
      113.652,
      114.012,
      114.859,
      115.382
     ]
