     "end": 22.426,
     "wordStarts": [
      18.85,
      19.14,
      19.488,
      19.988,
      20.313,
      20.696,
      21.241,
      21.485,
      21.59,
      21.787
     ]
    },
    {
     "text": "Job time only ever counts inside your shift. Never before you clock in. Never after you clock out.",
