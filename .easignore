# What an EAS build of the MOBILE app is allowed to upload.
#
# ⚠️ AN ALLOWLIST, NOT A BLOCKLIST. The blocklist that stood here let the
# archive grow to 373 MB — `.claude/` alone (agent worktrees) was 869 MB
# uncompressed — and it swept every loose file in the repository root onto
# Expo's build servers: security audit reports, pricing proposals, a company
# list and personal PDFs. A blocklist has to be told about each new file; this
# refuses everything at the root and names the few things a build reads.
#
# .easignore REPLACES .gitignore for the build archive, so the usual ignores
# are restated below for what IS allowed in.

/*
!/apps
!/packages
!/patches
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/tsconfig.base.json
!/eas.json
!/app.json
!/.npmrc
!/.nvmrc

# Of the apps, only the phone. packages/shared IS needed — apps/mobile imports
# @hbcfield/shared.
/apps/*
!/apps/mobile

# ── The usual ignores, restated because .easignore replaces .gitignore ──────
#
# Miss one and the archive GROWS. Leaving ios/ out took it from 202 MB to
# 529 MB, because that generated directory alone is a gigabyte and .gitignore
# was the only thing excluding it.

# Generated native projects. This is a managed (CNG) app — EAS generates these
# on the build server from app.config.ts, so uploading a local copy is both
# pointless and the single largest thing in the archive.
ios/
android/
.expo/

node_modules/
.git/
.next/
dist/
build/
coverage/
*.log
.env
.env.*
!.env.example
*.apk
.pnpm-store/
.turbo/
out/
logs/
.idea/
.vscode/
*.aab
*.ipa
.DS_Store

# ⚠️ The Play Console service-account key. `eas submit` reads it on THIS
# machine; the build never does, so it has no business on a build server.
play-store-key.json
