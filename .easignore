# What an EAS build of the MOBILE app does not need.
#
# Without this the archive is the whole monorepo — the web app, all four API
# services, infra and tooling — 202 MB that took nineteen minutes to upload
# before a build could even start. Three attempts died on that upload before
# one got through.
#
# .easignore REPLACES .gitignore for the build archive, so the usual ignores
# have to be restated below. Anything not listed is uploaded.

# ── Not part of the mobile app ──────────────────────────────────────────────
apps/web-app/
apps/admin/
apps/api/
infra/
docs/
tools/
backups/
scripts/

# packages/shared IS needed — apps/mobile imports @hbcfield/shared — so it is
# deliberately absent from the list above.

# ── The usual ignores, restated because .easignore replaces .gitignore ──────
#
# Miss one and the archive GROWS. Leaving ios/ out took it from 202 MB to
# 529 MB, because that generated directory alone is a gigabyte and .gitignore
# was the only thing excluding it.

# Generated native projects. This is a managed (CNG) app — EAS generates these
# on the build server from app.config.ts, so uploading a local copy is both
# pointless and the single largest thing in the archive.
ios/
android/
.expo/

node_modules/
.git/
.next/
dist/
build/
coverage/
*.log
.env
.env.*
!.env.example
*.apk
.pnpm-store/
.turbo/
out/
logs/
.idea/
.vscode/
*.aab
*.ipa
.DS_Store
