node_modules
*/node_modules
**/node_modules
.git
.gitignore
*.md
!README.md
.env
.env.*
!.env.example
# Secrets at ANY depth. The two lines above only match the context root, so
# every app's own .env (apps/api/*/.env, apps/web-app/.env.local, apps/mobile/.env)
# and the store/signing credentials were copied into the build context — and
# into any image layer whose COPY reached them.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/play-store-key.json
**/google-services.json
**/*.p8
**/*.p12
**/*.jks
**/*.key
dist
**/dist
# ESM build of packages/shared — regenerated inside the image by
# `pnpm --filter @hbcfield/shared build`, so a local copy is dead weight.
dist-esm
**/dist-esm
.next
**/.next
.expo
**/.expo
*.log
.DS_Store
**/.DS_Store
coverage
**/coverage
.vscode
.idea

# APK builds. On the production box these are ~213MB of untracked binaries sitting
# in the web app's public/ directory, and every image build copied them in. They
# are never served from there: both nginx sites alias /downloads/ to the host
# directory /opt/doergo/infra/docker/downloads/, which holds the newer APK that
# is actually offered for download. Excluding them takes ~213MB off the image
# and the build context without changing what any visitor can reach.
apps/web-app/public/downloads/
