      "pnpm": "9.15.0"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.100:4000/api/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyCJEw6XIE8Fnt6HRl8-xTFZF5mgRl17QT4"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hbcfield.com/api/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyCJEw6XIE8Fnt6HRl8-xTFZF5mgRl17QT4"
      }
    },
    "production": {
      "extends": "base",
