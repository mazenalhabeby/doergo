{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "pnpm": "9.15.0"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "channel": "development",
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hbcfield.com/api/v1"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hbcfield.com/api/v1"
      }
    },
    "production-apk": {
      "extends": "base",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hbcfield.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "production",
        "releaseStatus": "inProgress",
        "rollout": 0.2
      },
      "ios": {
        "appleId": "amd07dev@gmail.com",
        "ascAppId": "6762745260",
        "appleTeamId": "2NW5P5LXTH"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
