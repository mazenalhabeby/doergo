generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN // Organization owner/admin - full control
  EMPLOYEE // Everyone else. "Manager" capability is now the canViewAllTasks /
  // canAssignTasks access flags, not a role. (MANAGER + legacy
  // CLIENT/DISPATCHER/TECHNICIAN retired 2026-07-16.)
  CUSTOMER // External end-customer (resident/recipient) with portal access only.
  // Belongs to a Customer + optional CustomerUnit; sees ONLY their own requests.
  // Born onboardingCompleted=true; never reaches the org-builder or staff app.
}

// Platform access restriction
enum Platform {
  WEB // Web app only
  MOBILE // Mobile app only
  BOTH // Both platforms
}

// Access level for organization delegation
enum AccessLevel {
  NONE // No access - manager sees nothing
  TASKS_ONLY // Can view tasks only
  TASKS_ASSIGN // Can view tasks + assign workers
  FULL // Can view everything + assign
}

// Cross-org SPACE sharing (a space owned by org A shared with guest org B).
// Level maps to the unified permission keys for THAT space only:
//   VIEW       → canViewAllTasks (read board/tasks + owner-toggled extras)
//   CONTRIBUTE → VIEW + canCreateTasks (add tasks/requests, can't reassign)
//   CONTROL    → CONTRIBUTE + canAssignTasks (full task/worker control)
enum SpaceShareLevel {
  VIEW
  CONTRIBUTE
  CONTROL
}

// Share lifecycle. PENDING until the guest org accepts (invite+accept handshake);
// ACTIVE grants access; REVOKED/DECLINED are inert (never merged into a session).
enum SpaceShareStatus {
  PENDING
  ACTIVE
  REVOKED
  DECLINED
}

// A guest's "please add …" ask against a shared space (used when the guest can't
// act directly, or the owner keeps requests on). Discrete + human-approved →
// no auto-retrigger, no loop.
enum ShareRequestType {
  TASK
  WORKER
}

enum ShareRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  DRAFT
  NEW
  ASSIGNED
  ACCEPTED // Technician acknowledges the assigned task
  EN_ROUTE // Technician is traveling to the job location
  ARRIVED // Technician has arrived at the location
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELED
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_TOGGLED
  CHECKLIST_ITEM_REMOVED
}

enum TaskAssigneeRole {
  LEAD
  MEMBER
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum ReportAttachmentType {
  BEFORE // Photo taken before work started
  AFTER // Photo taken after work completed
}

// Time entry status for attendance tracking
enum TimeEntryStatus {
  CLOCKED_IN // Currently clocked in
  CLOCKED_OUT // Normal clock out
  AUTO_OUT // System auto clock-out (midnight, etc.)
}

// Time entry approval status
enum ApprovalStatus {
  PENDING // Awaiting manager review
  APPROVED // Manager approved
  REJECTED // Manager rejected
  AUTO // Auto-approved (e.g., within geofence, normal hours)
}

// Break type for attendance tracking
enum BreakType {
  LUNCH // Lunch break (typically 30-60 min)
  SHORT // Short break (typically 10-15 min)
  OTHER // Other break type
}

// How a space (CompanyLocation) interprets attendance expectations.
// Drives the shift resolver at clock-in and the reminder engine.
enum WorkModel {
  NONE // No attendance expectations (default — legacy behavior, no reminders)
  SHIFT // Rota-assigned shift windows (supports cross-midnight)
  FIXED // Weekly fixed schedule (legacy TechnicianSchedule)
  TASK // Task-based, no scheduled end (safety net only)
}

// Ownership classification of a Space — orthogonal to its physical/workspace
// nature (which is derived from lat/lng). A CUSTOMER space represents a customer
// company you do work for (carries contact fields); it replaces the retired
// standalone B2B "Customers" directory. Portal residents are NOT this — they stay
// on the Customer model.
enum SpaceKind {
  PROJECT // A project space
  COMPANY // Your own company / internal work area (default for existing spaces)
  CUSTOMER // A customer company you do work for
}

// Lifecycle of a still-open clock-in relative to its expected shift end.
// The engine NEVER force-closes — it nudges and escalates.
enum ShiftReminderState {
  NONE // Within expected shift, no reminder due yet
  REMINDED // Reminder push sent, awaiting worker response
  OVERTIME_PENDING // Worker chose "extra time", awaiting leader approval
  OVERTIME_APPROVED // Leader approved extra minutes, expected end extended
  ESCALATED // Reminders exhausted, escalated to a space leader to reconcile
  RESOLVED // Closed (worker clocked out or leader reconciled)
}

// Recurrence pattern for a rota assignment (member → shift within a space).
enum ShiftRecurrence {
  DAILY // Every day within the effective window
  WEEKLY // Specific days of the week (daysOfWeek)
  MONTHLY // Specific days of the month (daysOfMonth)
  ONE_OFF // Specific explicit dates
}

// Lifecycle of a geofence excursion ("out of ring") for one clock-in session.
// The heartbeat drives the state machine; nothing here force-clocks-out except an
// approver REJECT. See GeofenceExcursion model.
enum GeofenceExcursionStatus {
  OUT_UNREPORTED // Detected outside the ring; employee warned; no reason yet
  PENDING // Reason + requested minutes submitted; awaiting a decision
  APPROVED // Approved for grantedMinutes; countdown running
  REJECTED // Terminal — employee was clocked out
  RETURNED // Terminal — employee came back inside the ring; kept clocked in
  EXPIRED // Terminal for this cycle — APPROVED timer lapsed while still outside
}

// Time-off request status
/// What KIND of absence a request is.
///
/// Added with the leave allowance, because an allowance that deducts sick days
/// is not an allowance — it is a penalty for being ill. Only VACATION counts
/// against it. Until now the kind lived in a free-text `reason`, so nothing
/// could tell the two apart.
enum TimeOffType {
  VACATION // Counts against the annual allowance
  SICK // Does not
  FAMILY // Childcare, a family matter — does not
  OTHER // Does not
}

enum TimeOffStatus {
  PENDING // Awaiting manager approval
  APPROVED // Manager approved
  REJECTED // Manager rejected
  CANCELED // Technician canceled the request
}

// Invitation status
enum InvitationStatus {
  PENDING // Created, waiting to be used
  ACCEPTED // Used by a new user
  EXPIRED // Past expiry date
  REVOKED // Manually canceled by creator/admin
}

// Organization join policy
enum JoinPolicy {
  OPEN // Anyone with org code can request to join
  INVITE_ONLY // Only via one-time invitation codes
  CLOSED // No new members
}

// Join request status
enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ==================== MONITORING ENUMS ====================

// Monitoring event types for activity logging
enum MonitoringEventType {
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_DELETED
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  CLOCK_IN
  CLOCK_OUT
  GEOFENCE_VIOLATION
  TECHNICIAN_OFFLINE
  TASK_OVERDUE
  API_ERROR
  SERVICE_DOWN
  SERVICE_UP
}

// Alert severity levels
enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// Alert status
enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// Notification delivery channel
enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  SOCKET
}

// Notification delivery status
enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum OvertimeRequestStatus {
  PENDING_TECHNICIAN // Notification sent, waiting for tech to respond
  PENDING_APPROVAL // Technician said YES, waiting for team leader
  APPROVED // Team leader approved, overtime active
  REJECTED // Team leader rejected
  EXPIRED_NO_RESPONSE // Technician didn't respond in time
  EXPIRED_NO_APPROVAL // Team leader didn't respond in time
  COMPLETED // Overtime ended normally
  CANCELED // Technician declined
}

enum OvertimeApprovalMethod {
  REMOTE // Team leader approved via push notification on their device
  SIGNATURE // Team leader signed on the technician's phone
}

// Task creation scope — controls who the user can create tasks for
enum TaskCreationScope {
  NONE // Cannot create tasks
  SELF // Can only create tasks assigned to self
  SPACE // Can create tasks in spaces the user is assigned to
  ORG // Can create tasks for anyone in the organization
}

// Custom field types for organization-specific task fields
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
  EMAIL
}

// Recurrence frequency for recurring task templates
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

// Task dependency types (project management)
enum DependencyType {
  FINISH_TO_START // Predecessor must finish before successor starts
  START_TO_START // Predecessor must start before successor starts
  FINISH_TO_FINISH // Predecessor must finish before successor finishes
  START_TO_FINISH // Predecessor must start before successor finishes
}

// Sprint status for agile workflow
enum SprintStatus {
  PLANNING // Sprint is being planned
  ACTIVE // Sprint is in progress
  COMPLETED // Sprint is completed
}

// Models

// OrgRole retired (Phase 5b) — replaced by AccessRole (scope ORG) + User.memberRoleId.
// Table dropped in migration 20260807150000_drop_legacy_orgrole.

model Organization {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization profile
  industry              String? // e.g. "HVAC", "Plumbing", "Electrical", "General Contracting"
  // Opt-in capability: this org distinguishes in-house (employed) vs external
  // (freelance) FIELD workers. When false (default), the concept is hidden
  // everywhere and every field seat bills at the standard rate; when true, field
  // members carry an employmentType and in-house ones get the €9 seat. Defaulted
  // from industry at setup (trades on, IT/office off), toggleable in Settings.
  usesExternalWorkers   Boolean @default(false)
  address               String? // Legacy single-line address (kept for back-compat)
  addressLine1          String? // Street address
  addressLine2          String? // Suite / floor / unit (optional)
  city                  String?
  state                 String? // State / province / region
  postalCode            String? // ZIP / postal code
  country               String? // ISO 3166-1 alpha-2 code (e.g. "DE", "AT")
  phone                 String? // Contact phone
  email                 String? // Contact email (org-level, not user)
  website               String? // Website URL
  timezone              String? @default("Europe/Vienna") // IANA timezone
  /// Annual paid vacation days for this organization. The per-person override
  /// lives on User.leaveAllowance; this is what applies when that is unset.
  defaultLeaveAllowance Int     @default(25)
  logoUrl               String? // Organization logo

  // Join system
  joinCode     String? // Plaintext join code (displayed to admin)
  joinCodeHash String?    @unique // SHA-256 hash of persistent org join code
  joinPolicy   JoinPolicy @default(INVITE_ONLY)

  // Organization settings (JSON blobs for flexible config)
  profileBadges     Json? // { showRole, showWorkMode, showType, showSpecialty }
  notificationPrefs Json? // { emailOnTaskCreate, emailOnTaskComplete, emailOnJoinRequest, pushEnabled }
  securitySettings  Json? // { sessionTimeoutHours, requireStrongPassword, maxFailedAttempts }
  enabledModules    Json? // e.g. ["story_points", "epics", "sprints", "phases", "custom_fields", "time_tracking"]

  // ── SaaS billing (denormalized for fast guard reads; Subscription + Stripe are source of truth) ──
  stripeCustomerId  String?            @unique
  planTier          PlanTier? // LEGACY. Kept only so historic rows stay readable; nothing reads it to decide access. Gating is `addOns` + per-space modules.
  /// Capabilities bought once for the whole organization (invoicing, workflows,
  /// audit log…). Replaced tier-based gating: a thing is bought or it is not,
  /// so there is no ranking to reason about and no bundle table to keep in step
  /// with the price list. See packages/shared/src/billing/add-ons.ts.
  addOns            String[]           @default([])
  /// Billed by agreement, outside Stripe — an enterprise or negotiated contract.
  /// Nothing is charged automatically: reconcile never creates or updates a
  /// Stripe subscription, and checkout refuses. The bill is still COMPUTED and
  /// shown, because it is what the contract conversation is about — it is just
  /// labelled as an estimate rather than presented as a charge.
  billedExternally  Boolean            @default(false)
  subStatus         SubscriptionStatus @default(TRIALING)
  billingInterval   BillingInterval    @default(MONTHLY)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  // Platform-operator hard lock: when set, the org is forced read-only (via the
  // existing SubscriptionGuard) WITHOUT touching Stripe's subStatus. Reversible.
  suspendedAt       DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  billingEmail      String?
  vatId             String?

  // Customer invoicing: default billable labor rate (what you CHARGE a customer
  // per hour, distinct from internal worker cost). Integer EUR cents. Null = no
  // default → labor lines start blank for manual entry. A CUSTOMER space may
  // override this via CompanyLocation.billableRateCents.
  billableRateCents Int?

  // Support routing: manual pin to a support team (overrides routing rules). Null
  // = routed by rules / triage. Not a hard cascade — clearing the team keeps orgs.
  supportTeamId String?
  supportTeam   SupportTeam? @relation("OrgSupportTeam", fields: [supportTeamId], references: [id], onDelete: SetNull)

  users User[]
  tasks Task[]

  // Unified role model (Phase 1) — supersedes orgRoles + spaceRoles
  accessRoles      AccessRole[]
  spaceAssignments SpaceAssignment[]

  // Personnel file
  documentTypes     DocumentType[]
  documentTemplates DocumentTemplate[]
  documents         Document[]

  // Shift scheduling (space-centric attendance)
  shifts           Shift[]
  shiftAssignments ShiftAssignment[]

  // Organization delegation relationships
  /// Who owns this organization — normally whoever created it.
  ///
  /// On the organization rather than as a flag on the user: an org has exactly
  /// ONE owner, and a unique column holding one id IS that invariant. A boolean
  /// on users can drift into two owners or none, which no application code can
  /// make impossible. Nullable so the column can exist before it is filled, and
  /// so an owner's row disappearing leaves the organization standing.
  ownerId        String?              @unique
  owner          User?                @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  grantedAccess  OrganizationAccess[] @relation("Grantor") // Access this org has granted to others
  receivedAccess OrganizationAccess[] @relation("Grantee") // Access this org has received from others

  // Asset management
  assetCategories AssetCategory[]
  assets          Asset[]

  // Service reports
  serviceReports ServiceReport[]

  // Customers (first-class entity for customer-scoped work + reporting)
  customers Customer[]
  customerSignLinks CustomerSignLink[]

  // Customer portal (optional B2B2C / B2C module: residents/recipients submit requests)
  customerPortalEnabled Boolean          @default(false) // Org opt-in (true if any Portal exists)
  customerPortalConfig  Json? // LEGACY single-portal config (superseded by Portal rows; kept for migration)
  portals               Portal[] // Multiple portals per org (each its own type + categories + residents)
  customerUnits         CustomerUnit[] // Units/sites customers are tied to
  intakeCategories      IntakeCategory[] // Dynamic request-intake config

  // Saved report definitions (custom report builder)
  reportDefinitions ReportDefinition[]
  reportSchedules   ReportSchedule[]

  // Company locations for full-time technician attendance
  companyLocations CompanyLocation[]

  // Time entries for attendance tracking
  timeEntries TimeEntry[]

  // Invitations
  invitations Invitation[]

  // Notification routing (per-employee watchers)
  notificationWatches NotificationWatch[]

  // Join requests
  joinRequests JoinRequest[]

  // Project management
  phases  Phase[]
  sprints Sprint[]
  epics   Epic[]

  // Agile
  definitionsOfDone DefinitionOfDone[]

  // Custom workflows & fields
  workflows              StatusWorkflow[]
  customFieldDefinitions CustomFieldDefinition[]

  // Recurring tasks
  recurringTemplates RecurringTaskTemplate[]

  // Monitoring
  activityLogs           ActivityLog[]
  notificationDeliveries NotificationDelivery[]
  alerts                 Alert[]
  dailyMetrics           DailyMetric[]
  overtimeRequests       OvertimeRequest[]

  // Invoicing
  invoices Invoice[]

  supportTickets SupportTicket[]

  conversations Conversation[]

  // Schedule templates
  scheduleTemplates ScheduleTemplate[]

  // SaaS subscription / billing
  subscription  Subscription?
  billingEvents BillingEvent[]

  @@index([supportTeamId]) // orgs pinned to a support team
  @@map("organizations")
}

// Many-to-many delegation: Org A can manage Org B (if B grants access)
model OrganizationAccess {
  id String @id @default(cuid())

  // Who is granting access (the managed org)
  grantorOrgId String
  grantorOrg   Organization @relation("Grantor", fields: [grantorOrgId], references: [id], onDelete: Cascade)

  // Who is receiving access (the manager org)
  granteeOrgId String
  granteeOrg   Organization @relation("Grantee", fields: [granteeOrgId], references: [id], onDelete: Cascade)

  // Access level
  accessLevel AccessLevel @default(NONE)

  // Granular permissions (for fine-tuned control)
  canViewTasks     Boolean @default(false)
  canAssignWorkers Boolean @default(false)
  canViewWorkers   Boolean @default(false)
  canViewTracking  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each org pair can only have one access record
  @@unique([grantorOrgId, granteeOrgId])
  @@index([grantorOrgId])
  @@index([granteeOrgId])
  @@map("organization_access")
}

// Cross-org share of ONE space. Owner org (space.organizationId) shares a space
// with a guest org at a level + owner-configurable visibility scope. Plain-string
// fk-less ids (mirrors sourceCustomerId/taskId precedent) — cleanup handled in the
// share service. The security invariant: this is the ONLY thing that lets a guest
// org's session reach a foreign space, and only while status = ACTIVE.
model SpaceShare {
  id         String           @id @default(cuid())
  spaceId    String // the shared CompanyLocation (belongs to ownerOrgId)
  ownerOrgId String // = space.organizationId, denormalized for fast owner-side lists
  guestOrgId String // the org receiving access
  level      SpaceShareLevel  @default(VIEW)
  status     SpaceShareStatus @default(PENDING)

  // Owner-configurable visibility scope (dynamic — editable any time).
  showWorkers    Boolean @default(true)
  showAttendance Boolean @default(false)
  showTracking   Boolean @default(false)
  showReports    Boolean @default(false)
  allowRequests  Boolean @default(true)

  createdById  String
  acceptedById String?
  acceptedAt   DateTime?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests SpaceShareRequest[]

  @@unique([spaceId, guestOrgId]) // one share per (space, guest)
  @@index([guestOrgId, status]) // guest session-grant lookup (hot path)
  @@index([ownerOrgId, status]) // owner-side share list
  @@index([spaceId])
  @@map("space_shares")
}

// A guest's request for more work/workers on a shared space. One row, one owner
// decision; a resolved request never re-fires (no loop).
model SpaceShareRequest {
  id            String             @id @default(cuid())
  shareId       String
  share         SpaceShare         @relation(fields: [shareId], references: [id], onDelete: Cascade)
  spaceId       String
  guestOrgId    String
  requestedById String
  type          ShareRequestType
  title         String // requested task title, or role/skill needed
  note          String?
  status        ShareRequestStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, status])
  @@index([guestOrgId, status])
  @@index([shareId])
  @@map("space_share_requests")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Security: Account lockout fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Permission fields (granular access control)
  canCreateTasks      Boolean           @default(false) // Can create new tasks
  taskCreationScope   TaskCreationScope @default(NONE) // Granular task creation scope
  canViewAllTasks     Boolean           @default(false) // Can view all org tasks (vs only assigned/created)
  canAssignTasks      Boolean           @default(false) // Can assign tasks to technicians
  canManageUsers      Boolean           @default(false) // Can manage users in organization
  canViewReports      Boolean           @default(false) // May build/run reports (granted to Show-in-Management members)
  /// Overrides the organization default for this person (seniority, part-time,
  /// a negotiated contract). Null means "whatever the organization allows".
  leaveAllowance      Int?
  /// When this person actually started working here — NOT when their account
  /// was made. Used to pro-rate the first year's vacation.
  ///
  /// Deliberately separate from createdAt, and deliberately optional: an
  /// organization importing existing staff creates every account on the same
  /// day, and pro-rating from that would cut a third off everyone's allowance
  /// for a "join date" that never happened. Unset means no pro-rating.
  employmentStartDate DateTime?         @db.Date
  allowRemote         Boolean           @default(false) // May clock in remotely (WFH/anywhere), geofence-exempt
  presence            String? // Manual availability override: AVAILABLE | BUSY | AWAY (null = auto from task/clock)
  lastActiveAt        DateTime? // Last time the user made an authenticated request (throttled ~1/min) → online/last-seen

  // Which build of the app this person is actually running. Written only when
  // it changes, from a header the app sends — the steady state costs nothing.
  // Without it, "who is still on the old version" had no answer at all.
  lastAppVersion      String?
  lastAppPlatform     String?   // "android" | "ios"
  lastAppSeenAt       DateTime?
  // Contact directory / access — open within the org by default; admins restrict
  // via the Access Builder (canContact:false, or contactScope SELECTED).
  contactable         Boolean           @default(true) // CHAT: reachable in chat / messaging (inbound)
  contactScope        String            @default("NONE") // Who this member may contact: NONE | ALL | SELECTED (Phase 3: default none → space-driven)
  contactAllowedIds   String[]          @default([]) // When SELECTED: the specific contact user IDs this member may reach
  // MANAGEMENT DIRECTORY (separate from chat): surfaces this member in the org
  // "Management" contacts list teammates use to reach leadership. Admins always
  // appear regardless. Decoupled from chat `contactable` and from the perm role.
  showInManagement    Boolean           @default(false) // Listed in the Management directory
  // Per-recipient notification opt-outs by category, e.g. { "attendance": false }.
  // Missing/true = subscribed. Filters what THIS user receives (see NotificationWatch).
  notificationPrefs   Json?

  // Worker configuration
  position          String? // Free-form: "technician", "driver", "sales", "office_manager"
  scheduleType      String? @default("NONE") // "FIXED", "FLEXIBLE", "NONE"
  monthlyHourBudget Float? // For FLEXIBLE: target hours per month (e.g., 160)
  enabledModules    Json? // Mobile modules: ["tasks", "clock", "time_off"]
  // Employment relationship — drives the FIELD seat price for mobile-only members:
  // "IN_HOUSE" (the org employs them) → discounted €9 seat; "EXTERNAL"
  // (freelancer/contractor, default) → €15 seat. Office seats ignore this.
  employmentType    String? @default("EXTERNAL") // "IN_HOUSE" | "EXTERNAL"

  // Employee fields
  specialty    String? // e.g., "Electrical", "Plumbing", "Mechanical", "General"
  rating       Float?  @default(5.0) // Average rating (1-5)
  ratingCount  Int?    @default(0) // Number of ratings received
  maxDailyJobs Int?    @default(5) // Maximum jobs per day

  // Profile avatar
  avatarUrl String?

  // Profile badge visibility override (null = use org default)
  // JSON: { showRole, showWorkMode, showType, showSpecialty }
  profileBadges Json?

  // Per-user clock display preference: "24h" (default) or "12h" (AM/PM).
  // Display-only; does not affect stored timestamps or any server logic.
  timeFormat String? @default("24h")

  // Member's home IANA timezone. Used to anchor shifts / detect no-shows for a
  // LOGICAL space (no GPS on a no-show); falls back to the org timezone.
  timezone String?

  // Onboarding flag (false = orphan user needs to complete onboarding wizard)
  onboardingCompleted Boolean @default(true)

  // Has the one-time welcome guided tour auto-run for this account yet? New
  // accounts start false → the welcome tour auto-runs once on first dashboard
  // visit, then this flips true. Thereafter guides are launched only via the
  // "Help & guides" button. Existing users are backfilled to true (no re-show).
  guidesSeen Boolean @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// The organization this user owns, if any. Back-reference for ownerId above.
  ownedOrganization Organization? @relation("OrganizationOwner")
  breaksAddedForOthers Break[]     @relation("BreaksAddedForOthers")

  // Customer portal: for role=CUSTOMER, the Customer they log in as + optional
  // default unit. Null for staff (ADMIN/EMPLOYEE). See [[customer-portal]].
  customerId String?
  customer   Customer?     @relation("CustomerPortalUsers", fields: [customerId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       CustomerUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // The ASSET this login is confined to, for kinds that let a client hold one.
  // Same shape as unitId: an asset removed leaves the login, not a dangling id.
  assetId    String?
  asset      Asset?        @relation("AssetPortalUsers", fields: [assetId], references: [id], onDelete: SetNull)

  // Unified org-wide role (Phase 1) — supersedes orgRole
  memberRoleId String?
  memberRole   AccessRole? @relation(fields: [memberRoleId], references: [id], onDelete: SetNull)

  createdTasks        Task[]               @relation("TaskCreator")
  assignedTasks       Task[]               @relation("TaskAssignee")
  taskAssignments     TaskAssignee[]       @relation("TaskAssignees")
  comments            Comment[]
  attachments         Attachment[]
  taskEvents          TaskEvent[]
  lastLocation        WorkerLastLocation?
  locationHistory     LocationHistory[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  serviceReports      ServiceReport[]
  reportDefinitions   ReportDefinition[]   @relation("ReportCreator") // saved reports created
  reportSchedules     ReportSchedule[]     @relation("ReportScheduleCreator")
  spaceAssignments    SpaceAssignment[] // Unified per-space assignments (Phase 1)
  timeEntries         TimeEntry[] // Clock-in/clock-out records
  approvedTimeEntries TimeEntry[]          @relation("ApprovedTimeEntries") // Time entries approved by this user
  editedTimeEntries   TimeEntry[]          @relation("EditedTimeEntries") // Time entries edited by this user

  // Monitoring
  activityLogs           ActivityLog[]          @relation("ActivityLogUser") // Activity performed by this user
  targetedActivityLogs   ActivityLog[]          @relation("ActivityLogTarget") // Activity targeting this user
  notificationDeliveries NotificationDelivery[] // Notifications sent to this user
  alerts                 Alert[] // Alerts related to this user

  // Push notifications
  pushTokens UserPushToken[] // Device push tokens for notifications

  // Shift scheduling (space-centric attendance)
  shiftAssignments ShiftAssignment[] // Rota: shifts this member is assigned to

  // Availability management
  schedules        TechnicianSchedule[] // Weekly recurring schedule
  timeOffRequests  TimeOff[]            @relation("TechnicianTimeOff") // Time-off requests submitted
  approvedTimeOffs TimeOff[]            @relation("TimeOffApprover") // Time-off requests approved by this user

  // Invitations
  createdInvitations Invitation[] @relation("InvitationCreator") // Invitations created by this user

  // Join requests
  joinRequests         JoinRequest[] @relation("UserJoinRequests") // Join requests submitted by this user
  reviewedJoinRequests JoinRequest[] @relation("JoinRequestReviewer") // Join requests reviewed by this user

  // Overtime
  overtimeRequests         OvertimeRequest[] @relation("TechnicianOvertime")
  approvedOvertimeRequests OvertimeRequest[] @relation("OvertimeApprover")

  // Recurring tasks
  recurringTemplates RecurringTaskTemplate[] @relation("RecurringTaskCreator")

  // Invoices
  createdInvoices Invoice[] @relation("InvoiceCreator")

  // Support tickets this user opened (assigned agents are platform staff, not Users)
  supportTickets SupportTicket[] @relation("SupportCreatedBy")

  // Member-to-member chat
  chatMemberships ConversationMember[]
  chatMessages    Message[]            @relation("ChatMessageSender")

  // Notification routing: who is watched by whom (per-employee override)
  watchedBy NotificationWatch[] @relation("WatchSubject") // managers watching THIS user
  watching  NotificationWatch[] @relation("WatchWatcher") // users THIS manager watches

  // Personnel file
  documents          Document[]          @relation("UserDocuments") // their own file
  documentsIssued    Document[]          @relation("DocumentsIssued") // documents they published to others
  documentSignatures DocumentSignature[]
  documentEvents     DocumentEvent[] // evidence-trail entries they are the actor of

  documentSignerSteps DocumentSigner[] @relation("DocumentSignerUser")

  @@index([role])
  @@index([email])
  @@index([memberRoleId])
  @@index([organizationId, role, isActive]) // list technicians/members in org
  @@index([customerId]) // customer portal: a customer's login users
  @@index([organizationId, lastAppVersion]) // who in this org is still on an old build
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // Store SHA-256 hash, not plain token
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Grace period fields for handling concurrent refresh requests
  usedAt              DateTime? // When the token was first used (null = not used yet)
  replacedByTokenHash String? // Hash of the new token that replaced this one
  cachedAccessToken   String? // Cached access token to return during grace period
  cachedRefreshToken  String? // Cached refresh token to return during grace period (temporary, deleted after grace period)

  // Device/session tracking
  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([usedAt]) // For cleanup of old used tokens
  @@index([expiresAt]) // For expired token cleanup
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // Store SHA-256 hash, not plain token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// Push notification tokens for mobile devices
model UserPushToken {
  id        String   @id @default(cuid())
  token     String   @unique // Expo push token (e.g., ExponentPushToken[xxx])
  platform  String // 'ios' | 'android' | 'web'
  deviceId  String? // Optional device identifier for deduplication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_push_tokens")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         String       @default("NEW")
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?

  // Custom workflow association
  workflowId String?
  workflow   StatusWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  // Route tracking fields
  routeStartedAt DateTime? // When EN_ROUTE started
  routeEndedAt   DateTime? // When ARRIVED
  routeDistance  Float? // Total distance in meters

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  // Optional link to space (CompanyLocation) for space-centric workflows
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Optional link to asset for maintenance history
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Optional link to a customer (for customer-scoped reporting)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Where the task originated. INTERNAL (staff-created) | CUSTOMER_PORTAL (a
  // customer self-submitted it via the portal). Free-form String, mirrors status.
  source String @default("INTERNAL")

  // Triage gate. Internal tasks are born routed (true). A CUSTOMER_PORTAL request
  // is born UN-triaged (false): it has no flow/assignee yet and shows in the
  // portal's "Pending triage" inbox until an admin routes it (picks space + flow
  // + priority + worker → flips to true and it becomes a live task).
  triaged Boolean @default(true)

  // Optional link to the customer's unit/site the request is about
  unitId String?
  unit   CustomerUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Subtask hierarchy
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")
  depth    Int     @default(0) // Nesting level (0 = root, max 5)
  position Int     @default(0) // Order within siblings

  // Agile fields
  storyPoints Int? // Fibonacci: 1,2,3,5,8,13,21

  // Phase, Sprint & Epic associations
  phaseId  String?
  phase    Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId   String?
  epic     Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)

  // Dependencies
  predecessors TaskDependency[] @relation("DependencySuccessor")
  successors   TaskDependency[] @relation("DependencyPredecessor")

  comments        Comment[]
  attachments     Attachment[]
  events          TaskEvent[]
  locationHistory LocationHistory[]
  serviceReport   ServiceReport?
  assignees       TaskAssignee[]
  checklistItems  ChecklistItem[]
  customFields    CustomFieldValue[]

  @@index([status])
  @@index([createdById])
  @@index([assetId])
  @@index([createdAt])
  @@index([organizationId, status, createdAt])
  @@index([assignedToId, status, updatedAt]) // suggested-tech 30d/percentile capacity query (assignedToId + status + updatedAt range)
  @@index([dueDate]) // due date filtering/sorting
  @@index([parentId]) // subtask queries
  @@index([phaseId]) // phase filtering
  @@index([sprintId]) // sprint filtering
  @@index([epicId]) // epic filtering
  @@index([workflowId]) // workflow filtering
  @@index([spaceId]) // space filtering
  @@index([unitId]) // customer portal: requests for a unit
  @@index([organizationId, source, createdAt]) // portal-wide request list (filter org+source, sort by newest)
  @@index([organizationId, source, triaged]) // portal "pending triage" inbox count/list
  @@index([customerId, createdAt]) // portal request list (filter customer + sort by newest)
  @@index([organizationId, spaceId, status]) // space + status filtering
  @@map("tasks")
}

model TaskAssignee {
  id        String           @id @default(cuid())
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("TaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  role      TaskAssigneeRole @default(MEMBER)
  createdAt DateTime         @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text        String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, position])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Attachment {
  id        String         @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  AttachmentType
  fileSize  Int
  createdAt DateTime       @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

model TaskEvent {
  id        String        @id @default(cuid())
  eventType TaskEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([eventType])
  @@index([createdAt])
  @@index([taskId, createdAt]) // timeline queries
  @@index([userId, createdAt]) // per-member recent-activity (getRecentActivityForEmployee)
  @@map("task_events")
}

model WorkerLastLocation {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_last_locations")
}

// Location history for route tracking during EN_ROUTE status
model LocationHistory {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([taskId, timestamp])
  // Retention sweep filters on timestamp alone (no user/task prefix) — index it
  // so the nightly prune uses an index scan instead of a full table scan.
  @@index([timestamp])
  @@map("location_history")
}

// Dynamic category created by organization (e.g., "HVAC", "Electrical", "Plumbing")
/// What happened to one asset: notes people wrote, and the events worth keeping
/// (who it passed to, when). Mirrors CustomerActivity, minus the reminder
/// machinery, which belongs to sales rather than to a thing you own.
model AssetActivity {
  id             String @id @default(cuid())
  organizationId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// NOTE (somebody wrote it) or a system event such as HOLDER_CHANGED.
  type String  @default("NOTE")
  body String?

  /// Who logged it — a plain marker id with no FK, so removing a member never
  /// blocks and never erases the record of what they did.
  authorId String?

  /// Event detail, e.g. { from, to } on a holder change.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@map("asset_activities")
}

/// Money logged against one asset: rent coming in, a repair going out.
///
/// The heading is stored as TEXT, not a foreign key, so renaming or removing a
/// category on the kind never rewrites history — an entry keeps the word it was
/// filed under. Amounts are integer cents: money in floating point is a
/// rounding bug waiting for a large total.
model AssetMoney {
  id             String @id @default(cuid())
  organizationId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// The kind's category label, as it read when the entry was made.
  category    String
  /// IN (rent, a deposit) or OUT (a repair, fuel).
  direction   String
  /// Always positive. The direction beside it decides what it does to a total.
  amountCents Int
  note        String?

  /// When the money moved, which is not when somebody typed it in.
  occurredAt DateTime @default(now())
  /// Plain marker id, no FK — removing a member must not erase the books.
  authorId   String?

  createdAt DateTime @default(now())

  @@index([assetId, occurredAt])
  @@map("asset_money")
}

/// One row of a table on a record: a part on a machine, a key on an apartment.
///
/// A TABLE rather than JSON on the asset, because a machine can have hundreds of
/// parts: rows are counted, paged and searched without loading every one of them
/// alongside the record, and "which machines use this part" stays a query rather
/// than a scan of every asset's JSON.
///
/// `list` holds the list's NAME as the kind spelled it, so renaming a list on
/// the kind does not orphan rows — same reasoning as a money category.
model AssetListRow {
  id             String @id @default(cuid())
  organizationId String

  /// A row belongs to EITHER one record or the KIND (a shared catalogue typed
  /// once for every machine of that model). Exactly one of these is set —
  /// enforced by a check constraint, because a row owned by both or by neither
  /// would be invisible in one place and duplicated in the other.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  list   String
  /// Values keyed by COLUMN LABEL. JSON because the columns are the customer's,
  /// not ours, and a new column must not need a migration.
  values Json

  /// Explicit ordering: rows are a list somebody arranged, not a set.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, list, position])
  @@index([categoryId, list, position])
  @@map("asset_list_rows")
}

/// Who holds an asset — a resident, a driver, an operator.
///
/// A table rather than a column because a kind may allow SEVERAL, and a column
/// cannot hold several without becoming an array nobody can index, join or
/// constrain. One row per holder keeps the single case identical to the many
/// case: no branch, no second storage shape, and a real index for "what does
/// this person hold".
model AssetHolder {
  id String @id @default(cuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// A member of this organization. No foreign key, exactly as the column it
  /// replaces had none: removing a member must never be blocked by an asset
  /// still pointing at them.
  userId String?

  /// A client of this space. This one IS a foreign key — a customer record is
  /// ours to keep consistent.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// The same person cannot be added twice. Postgres treats NULLs as distinct,
  /// so these two only constrain the side that is actually set.
  @@unique([assetId, userId])
  @@unique([assetId, customerId])
  @@index([assetId])
  @@index([userId])
  @@index([customerId])
  @@map("asset_holders")
}

model AssetCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The SPACE this kind belongs to. Each space defines its own kinds, so the
  // depot's "Vehicles" is not the Linz office's "Vehicles". Nullable only so
  // rows that predate this keep working; new ones always carry a space.
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // What this kind's records look like: the name's label, whether they carry an
  // address (and so a map), who may hold one and what that is called, and the
  // fields every record is prompted for. Read through normalizeKindShape() —
  // it is JSON, so nothing may assume it is well formed.
  config Json?

  types    AssetType[]
  assets   Asset[]
  /// Shared catalogue rows — parts, fault codes — typed once for the kind.
  listRows AssetListRow[]

  // Unique per SPACE now, not per org — two spaces may both have "Vehicles".
  @@unique([organizationId, spaceId, name])
  @@index([organizationId])
  @@index([spaceId])
  @@map("asset_categories")
}

// Dynamic type within a category (e.g., under HVAC: "Air Conditioner", "Heater")
model AssetType {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  assets Asset[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("asset_types")
}

// The actual equipment/asset
model Asset {
  id           String  @id @default(cuid())
  name         String
  serialNumber String?
  model        String?
  manufacturer String?

  status AssetStatus @default(ACTIVE)

  installDate    DateTime?
  warrantyExpiry DateTime?

  locationAddress String?
  locationLat     Float?
  locationLng     Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  typeId String?
  type   AssetType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  // Who has it — the apartment "resident", generalised. The kind decides what
  // this is called ("Resident", "Driver") and who may be one. EITHER a member
  // or a client, never both, enforced in the service. holderUserId is a plain
  // marker id with no FK, exactly as CustomerUnit.residentUserId is, so
  // removing a member never blocks.
  holderUserId String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Values for the fields the KIND asks for ([{label, value}]), plus anything
  // added ad hoc on the record. JSON so a new field costs no migration —
  // mirrors CustomerUnit.details.
  details Json?

  /// Who has it. A kind decides whether that is one person or several; the
  /// join table carries both cases, so "several" is not a second code path.
  holders     AssetHolder[]
  activities  AssetActivity[]
  money       AssetMoney[]
  listRows    AssetListRow[]
  /// Portal logins confined to this asset (see User.assetId).
  portalUsers User[]          @relation("AssetPortalUsers")

  // Tasks linked to this asset (maintenance history)
  tasks          Task[]
  serviceReports ServiceReport[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([typeId])
  @@index([status])
  @@index([serialNumber])
  @@index([holderUserId])
  @@index([customerId])
  @@map("assets")
}

// Service report created when technician completes a task
// First-class customer entity — the party work is done for. Tasks and service
// reports link here so reporting can group reliably by customer (vs free text).
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  // Person vs Company. A COMPANY unlocks the B2B fields below (legal name, VAT,
  // register number, website, industry) + a flexible custom-details list.
  type String @default("PERSON") // PERSON | COMPANY

  // ── Company (B2B) fields — only meaningful when type = COMPANY ──
  legalName String? // registered/legal entity name if different from display name
  website   String?
  industry  String?
  vatId     String? // VAT / UID number (EU) — e.g. ATU12345678
  regNumber String? // company register number (e.g. Firmenbuchnummer FN 123456x)

  // Flexible extra attributes the office adds themselves: [{ label, value }].
  // Keeps the record open-ended without a schema change per new field.
  details Json?

  // Distinguishes a customer-portal RESIDENT (an end-user who logs into the app,
  // e.g. a tenant renting an apartment) from a B2B customer (a company you do
  // field-service work for). The office "Customers" list shows B2B; the Customer
  // Portal page manages residents. See [[customer-portal]].
  isPortalResident Boolean @default(false)

  // Which portal this resident belongs to (null for B2B customers). A resident
  // lives in exactly one portal → drives which flow/config the app shows them.
  portalId String?
  portal   Portal? @relation(fields: [portalId], references: [id], onDelete: SetNull)

  // The Space this customer belongs to (its CRM). A customer is a record in a
  // space's Customers list; sales works it with tasks. Null = legacy/org-level.
  // "Invite to app" (B2C module) turns it into a portal resident (login).
  spaceId String?
  space   CompanyLocation? @relation("SpaceCustomers", fields: [spaceId], references: [id], onDelete: SetNull)

  // Sales rep who owns the relationship (plain User-id marker, no FK).
  ownerId String?

  // Sales managers assigned to work this CRM relationship (User ids; no FK, so
  // removing a member never blocks). Empty once the customer gets app access —
  // an app customer is self-serve, so sales stops working them (handoff). See
  // the smart transition in CustomersService.update().
  managerIds String[] @default([])

  // CRM lifecycle stage (LEAD | CONTACTED | QUALIFIED | CUSTOMER | INACTIVE).
  // Free-form String so it stays flexible; labels/colors live in shared.
  status String @default("LEAD")

  tasks          Task[]
  serviceReports ServiceReport[]
  activities     CustomerActivity[] // CRM timeline: notes, calls, reminders, …

  // Customer portal
  portalUsers User[]         @relation("CustomerPortalUsers") // login accounts for this customer
  units       CustomerUnit[] // the units/sites this customer occupies

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Assets this client holds — flats, vehicles, machines.
  assetHolders AssetHolder[]
  // Things this client holds (see Asset.customerId).
  assets       Asset[]

  documentSignerSteps DocumentSigner[]
  documentSignatures  DocumentSignature[]
  signLinks           CustomerSignLink[]

  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@index([portalId])
  @@index([organizationId, spaceId]) // a space's Customers list
  @@map("customers")
}

// Kind of CRM timeline entry on a customer.
enum CustomerActivityType {
  NOTE // free-form note (what happened)
  CALL // logged phone call
  EMAIL // logged email
  MEETING // logged meeting / visit
  REMINDER // a follow-up task with a due date (what's next)
  STATUS // lifecycle stage change (auto-logged)
  SYSTEM // system event (invited to app, created, …)
}

// One entry in a customer's CRM activity timeline. Notes record what happened;
// REMINDER entries carry a dueAt/doneAt (what's next). Ordered by createdAt.
model CustomerActivity {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type     CustomerActivityType @default(NOTE)
  body     String?
  authorId String? // who logged it (User id, plain marker)

  // REMINDER only: when it's due, when completed, and when we notified.
  dueAt      DateTime?
  doneAt     DateTime?
  notifiedAt DateTime?

  // REMINDER dynamics:
  //  reminderKind    — what to do (CALL | EMAIL | MEETING | OTHER)
  //  remindBeforeMin — lead time; alert this many minutes before dueAt
  //  notifyAt        — computed fire time (dueAt − remindBeforeMin); the sweep
  //                    keys off this so "remind 1h before" just works.
  reminderKind    String?
  remindBeforeMin Int?      @default(0)
  notifyAt        DateTime?

  // Target ONE manager for this reminder (else all assigned managers are pinged).
  reminderAssigneeId String?
  // Recurrence: NONE | DAILY | WEEKLY | MONTHLY. On complete, the next
  // occurrence is auto-created so periodic check-ins never fall off.
  repeat             String? @default("NONE")

  metadata Json? // e.g. { from, to } for a STATUS change

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([notifyAt]) // due-reminder sweeps
  @@map("customer_activities")
}

// A customer portal — a self-contained B2C flow (type, branding, categories,
// residents). An org can run several (e.g. a Rental portal AND a Logistics one,
// or one per property). Supersedes the org-level customerPortalConfig.
model Portal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String // "Rivergate Rentals", "Downtown Deliveries"
  templateKey   String // rental | logistics | workplace | custom — the vertical/type
  entityLabel   String // "Apartment" | "Order" | "Workspace"
  contactLabel  String?
  accent        String?
  features      Json? // PortalFeatureFlags
  isActive      Boolean @default(true)
  coverImageUrl String? // optional hero/background photo for the client home

  // Optional: the space this portal routes to. When set, a client request is
  // pre-routed to this space (inherits its workflow) and triage becomes just
  // "confirm/edit flow + assign". When null, requests go to the manual triage
  // inbox (admin picks the space). fk-less (validated in the service).
  spaceId String?

  categories IntakeCategory[]
  customers  Customer[]
  units      CustomerUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
  @@map("portals")
}

// A unit/site an external customer is tied to — generic on purpose so it fits
// any vertical: an apartment (rental), an order (delivery), a workspace
// (facilities). Requests inherit the linked space's workflow for routing.
model CustomerUnit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Owning customer (nullable so a unit can exist before a resident is assigned)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Which portal this unit belongs to (null for legacy/unassigned).
  portalId String?
  portal   Portal? @relation(fields: [portalId], references: [id], onDelete: SetNull)

  name    String // "Apartment 766 C", "Order #A-3391", "Building B · Floor 3"
  label   String? // Optional entity-type override ("Apartment", "Order", "Workspace")
  address String?
  lat     Float?
  lng     Float?

  // On-site contact person for THIS address (a company customer can have a
  // different contact at each site). Shown on the address row.
  contactName  String?
  contactPhone String?

  // The MEMBER (staff User id) who LIVES in this apartment — staff / company
  // housing. Plain marker id (no FK, so removing a member never blocks). A unit
  // is occupied by EITHER a member (residentUserId) OR a client (customerId),
  // never both — enforced in the service. Work on the unit is handled by tasks.
  residentUserId String?

  // Requests about this unit route into this space (→ its workflow). Optional:
  // falls back to the org default space at task creation.
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Geocoded coordinates (for the map). lat/lng already declared above.

  // The customer's PRIMARY address (one per customer) — shown on the map.
  isPrimary Boolean @default(false)

  isActive Boolean @default(true)

  // Flexible property attributes the office adds: [{ label, value }] — floor,
  // rooms, size, rent, lease dates, access code, meters… Open-ended, no schema
  // churn per new field (mirrors Customer.details).
  details Json?

  users      User[] // portal logins whose default unit is this
  tasks      Task[] // requests submitted about this unit
  activities UnitActivity[] // apartment activity timeline (notes + system events)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
  @@index([customerId])
  @@index([spaceId])
  @@index([portalId])
  @@map("customer_units")
}

// Apartment activity timeline — free-text notes the office logs + auto system
// events (created, resident set/changed). Mirrors CustomerActivity; the work
// itself lives in tasks (History), this is the "what happened to the unit" feed.
model UnitActivity {
  id             String       @id @default(cuid())
  organizationId String
  unitId         String
  unit           CustomerUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type     String  @default("NOTE") // NOTE | SYSTEM
  body     String?
  authorId String? // who logged it (User id, plain marker)
  metadata Json? // e.g. { resident: "Anna Müller" }

  createdAt DateTime @default(now())

  @@index([unitId, createdAt])
  @@map("unit_activities")
}

// Dynamic request-intake config (per org). The category tree the portal shows
// residents ("Air Conditioning" → issues). Seeded from shared templates on
// module-enable; fully editable by the office. Routing: a category can pin the
// space (→ workflow) and default priority for the tasks it creates.
model IntakeCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which portal this category belongs to (required going forward; a category
  // is part of exactly one portal's flow).
  portalId String?
  portal   Portal? @relation(fields: [portalId], references: [id], onDelete: Cascade)

  key             String // machine key, unique per portal ("air_conditioning")
  label           String // display label ("Air Conditioning")
  icon            String? // icon name (mirrors the mobile icon set)
  color           String? // semantic color key ("cyan", "red", …)
  urgent          Boolean  @default(false) // auto-flag priority=URGENT for this category
  team            String? // routing hint shown to the customer ("HVAC team")
  defaultPriority String? // LOW | MEDIUM | HIGH | URGENT (null = MEDIUM)
  issues          String[] @default([]) // sub-issue labels ("Not cooling", "No power")
  position        Int      @default(0)
  isActive        Boolean  @default(true)

  // Optional: requests in this category route to this space (→ its workflow)
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portalId, key])
  @@index([organizationId, isActive])
  @@index([portalId, isActive])
  @@map("intake_categories")
}

// Saved report — a named, reusable report definition (config = the query spec:
// dataset + measures/dimensions/filters/granularity/dateRange). Built via the
// custom report builder (Pro+). Shared org-wide by default, or creator-private.
model ReportDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dataset     String
  config      Json // ReportDefinition query spec (client-safe, validated by the engine)
  isShared    Boolean @default(true) // visible org-wide vs creator-only

  createdById String
  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])

  schedules ReportSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@map("report_definitions")
}

// Scheduled delivery of a saved report (Business+). A poller runs due schedules,
// renders the report and emails it to recipients, then reschedules nextRunAt.
model ReportSchedule {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  cadence    String // 'daily' | 'weekly' | 'monthly'
  hour       Int      @default(7) // hour of day (UTC) to send
  dayOfWeek  Int? // 0-6 (Sun-Sat) for weekly
  dayOfMonth Int? // 1-28 for monthly
  recipients String[] @default([]) // email addresses
  isActive   Boolean  @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime

  createdById String
  createdBy   User   @relation("ReportScheduleCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, nextRunAt])
  @@index([organizationId])
  @@index([reportDefinitionId])
  @@map("report_schedules")
}

model ServiceReport {
  id String @id @default(cuid())

  // Link to task (one-to-one)
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Link to asset (denormalized for faster history queries)
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Work details
  summary       String // Brief summary of work done
  workPerformed String? // Detailed description
  workDuration  Int // Duration in seconds (from mobile timer)

  // Signatures (base64 encoded PNG or URL)
  technicianSignature String? @db.Text
  customerSignature   String? @db.Text
  customerName        String? // Who signed (free text)

  // Optional link to a customer entity (customer-scoped reporting)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Metadata
  completedAt   DateTime
  completedById String
  completedBy   User     @relation(fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attachments ReportAttachment[]
  partsUsed   PartUsed[]

  // Organization scope (for multi-tenant queries)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId])
  @@index([assetId])
  @@index([completedAt])
  @@index([completedById])
  @@index([customerId])
  @@index([organizationId, completedAt])
  @@map("service_reports")
}

// Attachment for service report (before/after photos)
model ReportAttachment {
  id String @id @default(cuid())

  reportId String
  report   ServiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  type     ReportAttachmentType // BEFORE or AFTER
  fileName String
  fileUrl  String
  fileSize Int // bytes
  caption  String? // Optional description

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_attachments")
}

// Parts/materials used in service
model PartUsed {
  id String @id @default(cuid())

  reportId String
  report   ServiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  name       String // "Air Filter", "Compressor Belt"
  partNumber String? // Optional SKU/part number
  quantity   Int     @default(1)
  unitCost   Float? // Optional cost per unit
  notes      String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("parts_used")
}

// A "space" — either a physical location (lat/lng set, used for attendance
// geofencing) or a logical workspace/project (no coordinates). Every task
// belongs to a space; modules + workflow are configured per space.
model CompanyLocation {
  id                String    @id @default(cuid())
  name              String // "Main Office", "Warehouse A", "General"
  address           String? // Full address string
  lat               Float? // Latitude (only for physical locations / attendance)
  lng               Float? // Longitude (only for physical locations / attendance)
  geofenceRadius    Int       @default(15) // Radius in meters for clock-in zone
  timezone          String    @default("Europe/Berlin") // IANA timezone (e.g. "America/New_York")
  workModel         WorkModel @default(NONE) // How attendance is interpreted for this space
  // Ownership classification (project / my company / customer company). Orthogonal
  // to physical-vs-workspace (derived from lat/lng). CUSTOMER spaces carry the
  // contact fields below and represent a customer you do work for.
  kind              SpaceKind @default(COMPANY)
  contactName       String? // CUSTOMER kind: primary contact
  contactEmail      String? // CUSTOMER kind: contact email
  contactPhone      String? // CUSTOMER kind: contact phone
  // Provenance: the legacy Customer this CUSTOMER space was migrated from (plain
  // marker, no FK). Makes the one-off backfill idempotent by id (never merges two
  // same-named customers) and links a customer-space back to its Customer record.
  sourceCustomerId  String?
  // CUSTOMER kind: per-space override of the org's default billable labor rate
  // (integer EUR cents). Null → fall back to Organization.billableRateCents.
  billableRateCents Int?
  isActive          Boolean   @default(true)
  isDefault         Boolean   @default(false) // The org's default space (holds otherwise-unassigned tasks)
  isRemote          Boolean   @default(false) // The org's "Remote" bucket for WFH clock-ins (no coords, geofence-exempt, hidden from pickers)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Space configuration
  enabledModules Json? // Override org modules for this space, e.g. ["time_tracking", "sprints"]
  workflowId     String?
  workflow       StatusWorkflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  // The workflows this space offers (supersedes the single workflowId above).
  workflows      SpaceWorkflow[]
  // Task types created here, or forked here from the library — this space's own.
  ownedWorkflows StatusWorkflow[] @relation("SpaceOwnedWorkflows")
  // Planning objects scoped to this space (null spaceId = organization-wide).
  sprints        Sprint[]         @relation("SpaceSprints")
  phases         Phase[]          @relation("SpacePhases")
  epics          Epic[]           @relation("SpaceEpics")

  // Space-driven routing (Phase 3). AccessRole ids whose holders in THIS space
  // are (a) notified about members here, and (b) contactable by members here.
  // Empty = default: the space's leader roles (permissions.canViewSpaceAttendance).
  notifyRoleIds  String[] @default([])
  contactRoleIds String[] @default([])
  /// The space's default approvers, when a member has no override.
  approveRoleIds String[] @default([])

  // Tasks linked to this space
  tasks Task[]

  // Recurring task templates that generate into this space
  recurringTemplates RecurringTaskTemplate[]

  // Technicians assigned to this location

  // Unified space assignments (Phase 1) — merges assignments + spaceMembers
  spaceAssignments SpaceAssignment[]

  // Shift scheduling (space-centric attendance)
  shifts           Shift[] // Shift definitions scoped to this space
  shiftAssignments ShiftAssignment[] // Rota: members assigned to shifts here

  // Time entries at this location
  timeEntries TimeEntry[]

  // Overtime requests at this location
  overtimeRequests OvertimeRequest[]

  // Customer portal: units & intake categories routing into this space
  customerUnits    CustomerUnit[]
  intakeCategories IntakeCategory[]

  // CRM: customer records belonging to this space's Customers list
  customers       Customer[]      @relation("SpaceCustomers")
  // Kinds of thing this space tracks (see AssetCategory.spaceId).
  assetCategories AssetCategory[]

  @@index([isActive])
  @@index([organizationId, kind, name]) // filter by kind + name-sorted lists (pickers, customer directory)
  @@index([sourceCustomerId]) // backfill idempotency + customer-space ↔ Customer lookup
  @@map("company_locations")
}

// Technician assignment to company location (many-to-many)
// TechnicianAssignment retired (Phase 5b) — merged into the unified
// SpaceAssignment model. Table dropped in migration
// 20260807160000_drop_legacy_technician_assignment.

// Per-employee notification routing override: a manager/admin (watcher) is
// subscribed to notifications ABOUT a specific employee (subject). When a
// subject has ANY watchers, they replace the default space/admin routing.
model NotificationWatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subjectUserId String
  subject       User   @relation("WatchSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  watcherUserId String
  watcher       User   @relation("WatchWatcher", fields: [watcherUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subjectUserId, watcherUserId])
  @@index([subjectUserId])
  @@index([watcherUserId])
  @@index([organizationId])
  @@map("notification_watches")
}

// Time entry for attendance tracking (clock-in/clock-out records)
model TimeEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id])

  status TimeEntryStatus @default(CLOCKED_IN)

  // Clock in data
  clockInAt       DateTime @default(now())
  clockInLat      Float
  clockInLng      Float
  clockInAccuracy Float?

  // Clock out data (null until clocked out)
  clockOutAt       DateTime?
  clockOutLat      Float?
  clockOutLng      Float?
  clockOutAccuracy Float?

  // Geofence validation results
  clockInWithinGeofence  Boolean  @default(true)
  clockOutWithinGeofence Boolean?

  // Remote work (WFH/anywhere): geofence-exempt, coarse place captured from GPS
  isRemote      Boolean @default(false)
  clockInPlace  String? // Coarse reverse-geocoded place, e.g. "Vienna, AT"
  clockOutPlace String?

  // IANA timezone WHERE the worker physically clocked in, derived from the
  // clock-in GPS at write-time (falls back to the space's timezone). This is the
  // zone the entry's times are displayed in — correct even for remote clock-ins.
  timezone String?

  // Calculated duration (set on clock-out)
  totalMinutes Int?

  // ── Shift expectation (resolved once at clock-in; server-authoritative) ──
  shiftId            String? // Resolved shift for this clock-in (null = no shift / task / flex)
  shift              Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  expectedClockOutAt DateTime? // Absolute UTC instant the shift is expected to end (cross-midnight safe)
  reminderState      ShiftReminderState @default(NONE) // Reminder/escalation lifecycle for an open entry
  nextRemindAt       DateTime? // When the next reminder push is due (null = nothing scheduled)
  reminderCount      Int                @default(0) // How many reminders have been sent for this entry

  // Break duration (calculated from breaks)
  breakMinutes Int @default(0)

  notes String?

  // Smart auto-approval
  flagReasons    String[]       @default([]) // e.g. ["OVERTIME", "LATE_ARRIVAL"]
  approvalStatus ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?          @relation("ApprovedTimeEntries", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNotes  String?

  // Edit tracking
  isEdited         Boolean   @default(false)
  editedById       String?
  editedBy         User?     @relation("EditedTimeEntries", fields: [editedById], references: [id])
  editedAt         DateTime?
  originalClockIn  DateTime? // Original value before edit
  originalClockOut DateTime? // Original value before edit
  editReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Breaks taken during this shift
  breaks Break[]

  // Overtime extension
  overtimeRequest OvertimeRequest?

  // Geofence "out of ring" excursions during this session
  geofenceExcursions GeofenceExcursion[]

  // Timestamped work-log ("what I did today") captured during the shift.
  workLog TimeEntryNote[]

  @@index([userId, clockInAt])
  @@index([locationId, clockInAt]) // per-location attendance by day
  @@index([approvalStatus])
  @@index([userId, status]) // check active clock-in
  @@index([organizationId, clockInAt]) // org attendance reports
  @@index([organizationId, status]) // "who's clocked in right now" (dashboard, date-independent)
  @@index([status, nextRemindAt]) // reminder engine safety-net sweep
  @@index([organizationId, reminderState]) // pending extra-time lookups per org
  @@index([organizationId, approvalStatus, clockInAt]) // approval queue (P3): pending, newest-first
  @@map("time_entries")
}

/// A timestamped work-log entry a member adds DURING a clock-in session
/// ("11:00 finished with the computer"). These compose the "what I did today"
/// report at clock-out. `userId` = the session's worker (the log belongs to them).
model TimeEntryNote {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  userId         String // the worker whose session this is
  authorId       String? // who actually wrote the note (member, or a manager acting on their behalf); null = legacy → treat as the member
  organizationId String

  body   String // the note text
  at     DateTime @default(now()) // when the work happened (device time / now)
  taskId String? // optional link to a task (fk-less; validated in the service)

  attachments TimeEntryNoteAttachment[]

  createdAt DateTime @default(now())

  @@index([timeEntryId, at])
  @@index([organizationId])
  @@map("time_entry_notes")
}

/// A photo/file attached to a work-log note. Stored on S3 (Hetzner) under
/// {orgId}/attendance/{YYYY}/{MM}/{DD}/{userId}/{timeEntryId}/{uuid}.{ext};
/// the DB holds only the key + metadata (no blobs).
model TimeEntryNoteAttachment {
  id     String        @id @default(cuid())
  noteId String
  note   TimeEntryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  organizationId String

  fileKey  String // S3 object key
  fileUrl  String // {endpoint}/{bucket}/{fileKey}
  fileName String // original filename (display)
  fileSize Int
  mimeType String
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@index([noteId])
  @@map("time_entry_note_attachments")
}

// ── Shift Issues (Blockers) ──────────────────────────────────────────────────
// A member on an active shift reports a blocker they can't fix. The responsible
// person is notified, acknowledges, can dispatch someone, and the whole thing
// plays out on ONE live thread (chat messages + system events interleaved).
enum ShiftIssueStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELED
}

enum ShiftIssueSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ShiftIssueEventType {
  CREATED
  MESSAGE
  ACKNOWLEDGED
  ASSIGNED
  STATUS_CHANGED
  RESOLVED
  REOPENED
  CLOSED
}

model ShiftIssue {
  id             String  @id @default(cuid())
  organizationId String
  timeEntryId    String? // the shift it happened on (fk-less; validated in service)
  spaceId        String? // CompanyLocation
  reportedById   String // the member who hit the blocker
  assignedToId   String? // dispatched worker ("send someone")

  title       String
  description String?
  severity    ShiftIssueSeverity @default(MEDIUM)
  status      ShiftIssueStatus   @default(OPEN)

  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?

  events ShiftIssueEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([reportedById])
  @@index([assignedToId])
  @@map("shift_issues")
}

model ShiftIssueEvent {
  id      String     @id @default(cuid())
  issueId String
  issue   ShiftIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  type        ShiftIssueEventType
  actorId     String? // who did it / sent the message
  body        String? // message text (MESSAGE) or system note
  metadata    Json? // e.g. { assignedToId, assignedToName, fromStatus, toStatus }
  attachments Json? // [{ fileKey, fileUrl, fileName, fileSize, mimeType, width, height }]

  at        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([issueId, at])
  @@map("shift_issue_events")
}

// One "left the ring" episode for a single clock-in session. The heartbeat drives
// the state machine; the ONLY automatic clock-out is an approver REJECT.
// "Active excursion" = latest row for a timeEntryId whose status is one of
// {OUT_UNREPORTED, PENDING, APPROVED}. At most one active per session (guarded in code).
model GeofenceExcursion {
  id             String                  @id @default(cuid())
  organizationId String
  timeEntryId    String // the active clock-in session
  userId         String
  spaceId        String // the space (CompanyLocation) whose ring was left
  status         GeofenceExcursionStatus @default(OUT_UNREPORTED)

  reason           String? // employee-provided
  requestedMinutes Int? // what the employee asked for
  grantedMinutes   Int? // what the approver granted (may differ)

  leftRingAt DateTime  @default(now()) // detected outside the ring
  reportedAt DateTime? // reason submitted → PENDING
  decidedAt  DateTime? // approve/reject timestamp
  expiresAt  DateTime? // APPROVED countdown end (drives sweep + re-check)
  resolvedAt DateTime? // RETURNED / EXPIRED / REJECTED

  approvedById  String?
  timerExpired  Boolean @default(false) // set by the sweep when an APPROVED timer lapses (approver flag)
  lastDistanceM Int? // distance from ring at detection (context for the approver)

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt]) // sweep: due APPROVED timers
  @@index([timeEntryId]) // active excursion for a session
  @@index([organizationId, status]) // approver list per org
  @@index([userId, status])
  @@map("geofence_excursions")
}

// Break records for time entries
model Break {
  id String @id @default(cuid())

  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  type BreakType @default(SHORT)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Duration in minutes (calculated on end)
  durationMinutes Int?

  notes String?

  /// Who added this break on the member's behalf. NULL — the normal case, and
  /// every row that existed before this — means the member recorded it
  /// themselves. A break somebody else entered must never be indistinguishable
  /// from one the member took: it changes paid hours, and the timesheet has to
  /// say whose account of the day it is.
  addedById String?
  addedBy   User?   @relation("BreaksAddedForOthers", fields: [addedById], references: [id], onDelete: SetNull)
  /// Why it was added. Required by the service whenever addedById is set.
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeEntryId])
  @@index([startedAt])
  @@map("breaks")
}

// ==================== AVAILABILITY & SCHEDULING ====================

// Technician recurring weekly schedule (e.g., "Monday 9:00-17:00")
model TechnicianSchedule {
  id String @id @default(cuid())

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String // "09:00" (24h format)
  endTime   String // "17:00" (24h format)
  isActive  Boolean @default(true)

  // Optional: schedule can be location-specific
  notes String? // Optional note (e.g., "Remote day")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each technician can only have one schedule entry per day
  @@unique([technicianId, dayOfWeek])
  @@index([technicianId])
  @@index([dayOfWeek, isActive])
  @@map("technician_schedules")
}

// Reusable schedule template (e.g., "Morning Shift", "Night Shift")
model ScheduleTemplate {
  id             String       @id @default(cuid())
  name           String // "Morning Shift", "Night Shift", "Flex 4x10"
  description    String?
  entries        Json // Array of { dayOfWeek, startTime, endTime, isActive, notes? }
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("schedule_templates")
}

// ==================== SHIFT SCHEDULING (space-centric attendance) ====================

// A single named shift window. Supports shifts that cross midnight
// (endLocal <= startLocal → crossesMidnight). Reusable; may be org-wide
// (spaceId null) or scoped to one space. The reminder engine reads its
// grace + reminder cadence.
model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional space scope: null = reusable across all of the org's spaces
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name        String // "Night Shift", "Early", "Late"
  description String?
  color       String? @default("#3b82f6")

  startLocal      String // "22:00" (24h, in the space's timezone)
  endLocal        String // "06:00"
  crossesMidnight Boolean @default(false) // derived: endLocal <= startLocal

  breakMinutes        Int @default(0) // Unpaid break subtracted from expected duration
  graceMin            Int @default(5) // Minutes after end before the first reminder fires
  reminderIntervalMin Int @default(5) // Gap between subsequent reminders
  maxReminders        Int @default(3) // Reminders before escalating to a space leader
  flagToleranceMin    Int @default(10) // Grace before flagging LATE_ARRIVAL / EARLY_DEPARTURE / OVERTIME (was a hardcoded 30)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]
  timeEntries TimeEntry[]

  @@index([organizationId])
  @@index([spaceId])
  @@map("shifts")
}

// Rota entry: assigns a member to a shift within a space on a recurrence.
// Effective-dated so edits/deletes never rewrite historical attendance —
// set effectiveTo to end an assignment instead of deleting the row.
model ShiftAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  spaceId String
  space   CompanyLocation @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  recurrence  ShiftRecurrence @default(WEEKLY)
  daysOfWeek  Int[]           @default([]) // WEEKLY: 0=Sun..6=Sat
  daysOfMonth Int[]           @default([]) // MONTHLY: 1..31
  dates       DateTime[]      @default([]) // ONE_OFF: explicit dates

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = open-ended; set to end (soft-delete) the assignment
  priority      Int       @default(0) // Higher wins when assignments overlap
  isActive      Boolean   @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, spaceId, isActive])
  @@index([spaceId])
  @@index([organizationId])
  @@index([isActive, effectiveFrom]) // materialize sweep: active rotas in-window (P4)
  @@map("shift_assignments")
}

/// A materialized expected shift occurrence for one member on one local day —
/// generated from the rota so a NO-SHOW (scheduled shift with no clock-in) can be
/// detected by the same indexed reminder sweep as forgot-to-clock-out. Clock-in
/// flips it PRESENT; the sweep reminds the worker then escalates to a space leader.
model ShiftInstance {
  id             String @id @default(cuid())
  organizationId String
  spaceId        String
  userId         String
  shiftId        String // rota shift (no-show is only materialized for rota shifts)

  localDate          String // YYYY-MM-DD in the resolution timezone (the shift's local day)
  expectedClockInAt  DateTime
  expectedClockOutAt DateTime

  // Lifecycle: PENDING → PRESENT (clocked in) | REMINDED → ESCALATED (no-show) | EXCUSED (time-off)
  state         String    @default("PENDING")
  reminderCount Int       @default(0)
  nextRemindAt  DateTime? // when the sweep should next act (set to grace-until at create; null when resolved)
  timeEntryId   String? // the fulfilling clock-in, when PRESENT
  excuseReason  String? // why the no-show was excused (e.g. approved absence, sick leave)
  excusedById   String? // who excused it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, spaceId, shiftId, localDate]) // idempotent materialization
  @@index([state, nextRemindAt]) // the no-show sweep (drain due rows)
  @@index([userId, localDate]) // clock-in fulfillment lookup
  @@index([organizationId, spaceId, localDate]) // admin/no-show listing
  @@map("shift_instances")
}

// SpaceRole + SpaceMember retired (Phase 5) — fully replaced by AccessRole
// (scope SPACE) + SpaceAssignment. Tables dropped in migration
// 20260807140000_drop_legacy_space_role_member.

// ==================== UNIFIED ROLE MODEL (Phase 1) ====================
// One role entity for BOTH org-wide and per-space roles, carrying the unified
// permission vocabulary. Supersedes OrgRole (org) + SpaceRole (space), which are
// kept intact during migration and removed in Phase 5. Nothing reads these two
// new tables yet — Phase 2 wires the resolver/guards.

enum RoleScope {
  ORG // applies org-wide (assigned on the member)
  SPACE // applies within a space (assigned on a space)
  BOTH // usable in either place
}

model AccessRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  color       String?   @default("#6b7280")
  scope       RoleScope @default(BOTH)
  isSystem    Boolean   @default(false) // Seeded built-in, editable but non-deletable
  legacyKind  String? // migration provenance: 'org' | 'space'
  position    Int       @default(0)
  isActive    Boolean   @default(true)

  // Unified permission set (shared PermissionSet):
  // { canCreateTasks, canViewAllTasks, canAssignTasks, canManageUsers,
  //   canViewReports, canApproveOvertime, canManageRota,
  //   canReconcileAttendance, canViewSpaceAttendance }
  permissions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           User[] // org-wide holders (User.memberRoleId)
  spaceAssignments  SpaceAssignment[] // per-space holders
  documentTemplates DocumentTemplate[] // contract templates bound to this role
  invitations       Invitation[] // invites pre-assigning this role

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

// Merges TechnicianAssignment (schedule / primary / effective dates) with
// SpaceMember (per-space role). One row per (user, space) — carries the
// member's role FOR THAT SPACE.
model SpaceAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  spaceId String
  space   CompanyLocation @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  roleId String?
  role   AccessRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  isPrimary     Boolean   @default(false)
  schedule      String[]  @default([]) // Work days: ["MON","TUE",...]
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Per-member, per-space routing OVERRIDE (Phase 4d). Who is notified ABOUT this
  // member / who this member may CONTACT, within THIS space — as space roles
  // (AccessRole ids) and/or specific users. Empty on a kind = fall back to the
  // space default (CompanyLocation.notify/contactRoleIds), else the space leaders.
  notifyRoleIds  String[] @default([])
  notifyUserIds  String[] @default([])
  contactRoleIds String[] @default([])
  contactUserIds String[] @default([])
  /// Who signs off FOR this member. A third kind, not a synonym for notify:
  /// wanting to hear about somebody's shifts is not authority over their hours.
  approveRoleIds String[] @default([])
  approveUserIds String[] @default([])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("space_assignments")
}

// Time-off request (vacation, sick day, personal leave)
model TimeOff {
  id String @id @default(cuid())

  technicianId String
  technician   User   @relation("TechnicianTimeOff", fields: [technicianId], references: [id], onDelete: Cascade)

  startDate DateTime    @db.Date // First day of time off
  endDate   DateTime    @db.Date // Last day of time off (inclusive)
  type      TimeOffType @default(VACATION) // Only VACATION is deducted from the allowance
  reason    String? // Free-text note; the KIND is `type`, not this

  status TimeOffStatus @default(PENDING)

  // Approval workflow
  approvedById    String?
  approvedBy      User?     @relation("TimeOffApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String? // If rejected, reason why

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedById])
  @@index([technicianId, status, startDate]) // no-show sweep: approved leave per worker (P8)
  @@map("time_off_requests")
}

// ==================== INVITATION SYSTEM ====================

// Invitation for users to join an organization with a pre-assigned role
model Invitation {
  id String @id @default(cuid())

  // Short code (plaintext for display + SHA-256 hash for validation)
  code     String?
  codeHash String  @unique

  // Target role and organization
  targetRole     Role
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unified org-wide role (AccessRole) pre-assigned at invite (e.g. Manager),
  // validated server-side + applied to the member's memberRoleId on accept.
  memberRoleId String?
  memberRole   AccessRole? @relation(fields: [memberRoleId], references: [id], onDelete: SetNull)

  // Technician-specific fields (only used when targetRole = TECHNICIAN)
  position          String?
  scheduleType      String? // NONE | FIXED | FLEXIBLE — applied to the user on accept
  schedule          Json? // Weekly rows when FIXED: [{dayOfWeek,startTime,endTime,isActive}]
  monthlyHourBudget Int? // When FLEXIBLE
  enabledModules    Json?
  // Full pre-configured Access Profile (platform, permissions, feature tabs,
  // space scope, contact/management flags) applied to the member on accept — so
  // their first screen already matches their final access. Shape = AccessPersisted.
  accessProfile     Json?
  specialty         String?
  maxDailyJobs      Int?

  // Pre-assigned space (CompanyLocation id) — the accepting user is assigned to it.
  spaceId String?

  // Customer-portal invite (only used when targetRole = CUSTOMER): which Customer
  // the new login is bound to + an optional default unit + the portal. Scalar refs
  // (validated on accept) — the invitation is transient so no FK relation is kept.
  customerId String?
  unitId     String?
  /// Invite a client to one ASSET — the generalisation of unitId, for any type
  /// whose records a client may hold.
  assetId    String?
  portalId   String?

  // Status tracking
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?

  // Who accepted the invitation (null until accepted)
  acceptedById String?

  // Who created the invitation
  createdById String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([expiresAt])
  @@index([organizationId, status])
  @@index([assetId])
  @@map("invitations")
}

// ==================== JOIN REQUEST SYSTEM ====================

// Request from an orphan user to join an organization
model JoinRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  message String? // Optional message from the requesting user

  status JoinRequestStatus @default(PENDING)

  // Review fields (set when admin approves/rejects)
  reviewedById    String?
  reviewedBy      User?     @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Role assignment (set by admin on approval)
  assignedRole     Role?
  assignedPlatform Platform?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, organizationId, status])
  @@index([organizationId, status])
  @@index([reviewedById])
  @@map("join_requests")
}

// ==================== MONITORING MODELS ====================

// Activity log for audit trail
model ActivityLog {
  id        String @id @default(cuid())
  // Free-form action string (e.g. "USER_LOGIN", "MEMBER_ROLE_CHANGED",
  // "TASK_DELETED", "LOCATIONS_UPDATED") so any mutation can be audited without
  // an enum migration. The gateway audit interceptor writes these.
  eventType String

  // Who performed the action
  userId String?
  user   User?   @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  // Who was affected (e.g., user being assigned, deleted)
  targetUserId String?
  targetUser   User?   @relation("ActivityLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Resource context
  resourceType String? // "task", "user", "report", "timeEntry", etc.
  resourceId   String?

  // Additional context
  metadata  Json? // { previousStatus, newStatus, reason, etc. }
  ipAddress String?
  userAgent String?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  // Serves the per-entity audit trail: WHERE resourceId = ? ORDER BY createdAt DESC.
  @@index([resourceId, createdAt])
  @@map("activity_logs")
}

// System health metrics (time-series data)
model HealthMetric {
  id          String   @id @default(cuid())
  serviceName String // "gateway", "auth-service", "task-service", etc.
  metricType  String // "latency", "error_rate", "request_count", "memory_usage"
  value       Float
  timestamp   DateTime @default(now())
  metadata    Json? // { endpoint, statusCode, errorMessage, etc. }

  @@index([serviceName, timestamp])
  @@index([metricType, timestamp])
  @@map("health_metrics")
}

// Notification delivery tracking
model NotificationDelivery {
  id      String              @id @default(cuid())
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  // Recipient
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Event that triggered the notification
  eventType String // "task.assigned", "task.completed", "alert.raised", etc.
  payload   Json? // The notification content/data

  // Delivery tracking
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  retryCount    Int       @default(0)
  // In-app inbox read state (null = unread). Powers the notification bell.
  readAt        DateTime?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([channel, status])
  @@index([eventType])
  // Retention sweep filters on createdAt alone — index it (H4).
  @@index([createdAt])
  @@map("notification_deliveries")
}

// Real-time alerts
model Alert {
  id       String        @id @default(cuid())
  type     String // "technician_offline", "task_overdue", "geofence_violation", "high_error_rate"
  severity AlertSeverity @default(WARNING)
  status   AlertStatus   @default(ACTIVE)

  // Alert content
  title    String
  message  String
  metadata Json? // { technicianName, taskId, lastSeen, overdueBy, etc. }

  // Related entities (optional)
  userId String? // Related user (e.g., offline technician)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskId String? // Related task

  // Lifecycle tracking
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([severity, status])
  @@index([type, createdAt])
  @@index([userId])
  @@map("alerts")
}

// Daily aggregated metrics for reports (computed nightly)
model DailyMetric {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Task metrics
  tasksCreated      Int    @default(0)
  tasksCompleted    Int    @default(0)
  tasksCanceled     Int    @default(0)
  tasksOverdue      Int    @default(0)
  avgCompletionTime Float? // Average time to complete tasks (in minutes)

  // User metrics
  activeUsers      Int @default(0)
  loginCount       Int @default(0)
  failedLoginCount Int @default(0)

  // Attendance metrics
  clockInCount       Int    @default(0)
  avgWorkHours       Float? // Average hours worked
  geofenceViolations Int    @default(0)

  // Notification metrics
  emailsSent   Int @default(0)
  emailsFailed Int @default(0)
  pushSent     Int @default(0)
  pushFailed   Int @default(0)

  // Alert metrics
  alertsRaised   Int @default(0)
  alertsResolved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, organizationId])
  @@index([organizationId, date])
  @@map("daily_metrics")
}

// Overtime request when technician's shift ends
model OvertimeRequest {
  id String @id @default(cuid())

  // Who is requesting overtime
  technicianId String
  technician   User   @relation("TechnicianOvertime", fields: [technicianId], references: [id], onDelete: Cascade)

  // Which time entry this overtime extends
  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  // Which location
  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id])

  // Status tracking
  status OvertimeRequestStatus @default(PENDING_TECHNICIAN)

  // Technician response
  technicianRespondedAt DateTime?
  technicianReason      String? // Why tech needs overtime

  // Approval details
  approvalMethod  OvertimeApprovalMethod?
  approvedById    String?
  approvedBy      User?                   @relation("OvertimeApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approverNotes   String?

  // Signature (Path B - team leader signs on tech's phone)
  leaderName      String?
  leaderSignature String? @db.Text // base64 PNG

  // Overtime parameters
  maxDurationMinutes Int? // Max overtime allowed (set by leader)
  overtimeStartAt    DateTime? // When overtime period began
  overtimeEndAt      DateTime? // When overtime should end (scheduled)
  actualEndAt        DateTime? // When overtime actually ended

  // Calculated
  overtimeMinutes Int? // Actual overtime worked

  // Timeout tracking
  technicianTimeoutAt DateTime? // When 15-min window expires
  approvalTimeoutAt   DateTime? // When 10-min approval window expires

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId, status])
  @@index([organizationId, status])
  @@index([timeEntryId])
  @@index([status, technicianTimeoutAt])
  @@index([status, approvalTimeoutAt])
  @@map("overtime_requests")
}

// ==================== PROJECT MANAGEMENT ====================

// Phase or milestone for grouping tasks
model Phase {
  id             String           @id @default(cuid())
  name           String
  description    String?
  color          String           @default("#3b82f6")
  type           String           @default("phase") // "phase" or "milestone"
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * The space this belongs to.
   * NULL means organization-wide — how every one of these worked before spaces
   * owned anything, and what existing rows stay. Set means it belongs to that
   * space, and the modules that govern it are that space's rather than the
   * organization's.
   * Nullable on purpose: making it required would have forced every existing
   * row into some arbitrary space, and "belongs everywhere" is a real answer
   * for an organization that runs one backlog across its sites.
   */
  spaceId        String?
  space          CompanyLocation? @relation("SpacePhases", fields: [spaceId], references: [id], onDelete: SetNull)
  startDate      DateTime?
  endDate        DateTime?
  position       Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          Task[]

  @@index([organizationId])
  @@map("phases")
}

// Sprint for agile workflow
model Sprint {
  id             String           @id @default(cuid())
  name           String
  goal           String?
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * The space this belongs to.
   * NULL means organization-wide — how every one of these worked before spaces
   * owned anything, and what existing rows stay. Set means it belongs to that
   * space, and the modules that govern it are that space's rather than the
   * organization's.
   * Nullable on purpose: making it required would have forced every existing
   * row into some arbitrary space, and "belongs everywhere" is a real answer
   * for an organization that runs one backlog across its sites.
   */
  spaceId        String?
  space          CompanyLocation? @relation("SpaceSprints", fields: [spaceId], references: [id], onDelete: SetNull)
  startDate      DateTime
  endDate        DateTime
  status         SprintStatus     @default(PLANNING)
  position       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          Task[]
  report         SprintReport?

  @@index([organizationId, status])
  @@map("sprints")
}

// Epic for grouping tasks into larger initiatives
model Epic {
  id             String           @id @default(cuid())
  name           String
  description    String?
  color          String           @default("#8b5cf6")
  status         String           @default("OPEN") // OPEN, IN_PROGRESS, DONE
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * The space this belongs to.
   * NULL means organization-wide — how every one of these worked before spaces
   * owned anything, and what existing rows stay. Set means it belongs to that
   * space, and the modules that govern it are that space's rather than the
   * organization's.
   * Nullable on purpose: making it required would have forced every existing
   * row into some arbitrary space, and "belongs everywhere" is a real answer
   * for an organization that runs one backlog across its sites.
   */
  spaceId        String?
  space          CompanyLocation? @relation("SpaceEpics", fields: [spaceId], references: [id], onDelete: SetNull)
  startDate      DateTime?
  targetDate     DateTime?
  position       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          Task[]

  @@index([organizationId])
  @@map("epics")
}

// Sprint report generated when a sprint completes
model SprintReport {
  id                String   @id @default(cuid())
  sprintId          String   @unique
  sprint            Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  organizationId    String
  committedPoints   Int      @default(0)
  completedPoints   Int      @default(0)
  committedTasks    Int      @default(0)
  completedTasks    Int      @default(0)
  carriedOverTasks  Int      @default(0)
  carriedOverPoints Int      @default(0)
  addedMidSprint    Int      @default(0)
  removedMidSprint  Int      @default(0)
  velocity          Float    @default(0) // completedPoints
  dailyBurndown     Json // array of { date: string, remaining: number, ideal: number }
  createdAt         DateTime @default(now())

  @@index([organizationId])
  @@map("sprint_reports")
}

// Definition of Done for organization quality gates
model DefinitionOfDone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String? // optional: tied to specific workflow
  items          Json // array of { text: string, isRequired: boolean }
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("definition_of_done")
}

// Task dependency (predecessor/successor relationship)
model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  predecessor   Task           @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     Task           @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType @default(FINISH_TO_START)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now())

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
  @@map("task_dependencies")
}

// ==================== CUSTOM STATUS WORKFLOWS ====================

// Organization-level custom status workflow
model StatusWorkflow {
  id                 String                  @id @default(cuid())
  organizationId     String
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * How far this task type reaches.
   * NULL — the organization's: any of its spaces may offer it, and one edit
   * fixes a typo everywhere. Set — this space's own, created here or forked
   * from the library, and no other space may offer it. Local is the default
   * because widening later is easy and narrowing after five spaces adopted it
   * is not.
   * Not a separate ownership model on purpose: a space-scoped type is still an
   * org-owned row, so every tenancy check, cache key and query cost is the one
   * that was already there.
   */
  ownerSpaceId       String?
  ownerSpace         CompanyLocation?        @relation("SpaceOwnedWorkflows", fields: [ownerSpaceId], references: [id], onDelete: Cascade)
  name               String // "Default", "Field Service", "Logistics", etc.
  /**
   * What the TASK carries throughout its life — sprint, story points, epic,
   * phase, subtasks, dependencies, crm.
   * Separate from WorkflowStatus.capabilities, which say what the member does
   * at one step. "A task belongs to a sprint" is not true at step three and
   * false at step four, so it cannot live on a status. Both lists feed the same
   * module requirement (see `modulesRequiredByWorkflow` in shared).
   */
  capabilities       String[]                @default([])
  isDefault          Boolean                 @default(false)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  statuses           WorkflowStatus[]
  tasks              Task[]
  spaces             CompanyLocation[]
  customFields       CustomFieldDefinition[]
  recurringTemplates RecurringTaskTemplate[]
  spaceOfferings     SpaceWorkflow[]

  // Names are unique per SPACE for a local type and per ORGANIZATION for a
  // shared one — enforced in the service, because a partial unique index cannot
  // express "unique within this column's value OR within the org when it is
  // null" without two indexes that disagree at the boundary.
  @@index([organizationId])
  @@index([ownerSpaceId])
  @@map("status_workflows")
}

/**
 * Which workflows a space offers.
 * A workflow stays owned by the ORGANIZATION — one definition, so fixing a typo
 * fixes it everywhere — and this decides which of them each space presents and
 * which is its default. Space-owned workflows would mean a copy per space and a
 * typo fixed once per space; when a space genuinely needs to diverge, it
 * duplicates the workflow, deliberately.
 * Supersedes CompanyLocation.workflowId, which stays as the fallback until this
 * has run quietly for a while.
 */
model SpaceWorkflow {
  id         String          @id @default(cuid())
  spaceId    String
  space      CompanyLocation @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   StatusWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // At most one per space — enforced by a partial unique index in the migration,
  // because "the default" being ambiguous is a bug no application code can fix
  // after the fact.
  isDefault  Boolean         @default(false)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())

  @@unique([spaceId, workflowId]) // offered once, not twice
  @@index([spaceId])
  @@index([workflowId])
  @@map("space_workflows")
}

/**
 * The task-type LIBRARY — platform-curated, shared by every tenant.
 * Deliberately has no organizationId: it belongs to the platform, and tenants
 * only ever read it. A tenant that picks one gets a COPY (StatusWorkflow +
 * WorkflowStatus rows of its own). Nothing points back here afterwards.
 * Referencing a template live instead of copying it would mean a curator's edit
 * rewriting the state machine under every tenant's in-flight tasks — and a task
 * whose current status stopped existing has no transition out of it. Letting
 * tenants write here would make one org's edit another org's options, a
 * cross-tenant write in a system that otherwise has none.
 * `definition` is the status list as JSON. It is read back through
 * `normalizeTemplateStatuses` (shared) before any of it becomes a row, because
 * JSON has no schema and this row was written by a different party than the one
 * using it.
 */
model WorkflowTemplate {
  id               String    @id @default(cuid())
  // Stable across renames, and how a built-in template is recognised so seeding
  // never creates it twice.
  slug             String    @unique
  name             String
  description      String?
  industry         String? // "field-service", "logistics", "cleaning" — for grouping
  icon             String?
  position         Int       @default(0)
  // Unpublished means invisible to tenants. A template is published only once it
  // passes validation, so the library cannot hand out a workflow that traps work.
  isPublished      Boolean   @default(false)
  // Seeded from code. Kept so a curator can tell a shipped template from one
  // they wrote, and so seeding can leave curated edits alone.
  isBuiltIn        Boolean   @default(false)
  /**
   * Where a submitted template came from — for the curator only.
   * The tenant-facing read selects named fields and never includes these, so a
   * published template carries no trace of who wrote it. That is deliberate: a
   * flow's step names are a business's process, and often a customer's name.
   * The curator needs provenance to review and to tell the submitter it landed;
   * everybody else does not.
   */
  submittedByOrgId String?
  submittedAt      DateTime?
  // "<orgId>:<workflowId>" — so re-submitting the same task type updates the row
  // a curator may already be reading instead of queueing a second copy of it.
  sourceKey        String?   @unique
  definition       Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isPublished, industry])
  @@map("workflow_templates")
}

// Individual status within a workflow
model WorkflowStatus {
  id           String         @id @default(cuid())
  workflowId   String
  workflow     StatusWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name         String // "New", "In Transit", "Delivered", etc.
  /**
   * Translation key, for steps that came from a SHIPPED template.
   * A status name is tenant data — someone typed it — so it cannot live in a
   * locale file. But most names are not typed at all: they arrive from the
   * library, in English, and then a German org reads "On The Way" forever.
   * So a step copied from a shipped template carries the key its name came
   * from, and the client renders `t(nameKey, { defaultValue: name })`. Costs
   * nothing: no join, no extra query, no per-locale table — the lookup is a
   * hash hit in a bundle already in memory. A step someone wrote has no key and
   * renders exactly what they wrote, which is correct: a name typed in German
   * must not be "translated" into anything.
   * Renaming a shipped step clears the key, because it is then their name.
   */
  nameKey      String?
  key          String // "NEW", "IN_TRANSIT", "DELIVERED" — machine-readable
  color        String         @default("#3b82f6")
  icon         String? // optional lucide icon name
  position     Int            @default(0)
  isFinal      Boolean        @default(false) // marks completion states
  isCanceled   Boolean        @default(false) // marks cancellation states
  transitions  String[] // array of WorkflowStatus keys this status can transition TO
  capabilities String[]       @default([]) // execution widgets active at this step (gps, timer, …)
  createdAt    DateTime       @default(now())

  @@unique([workflowId, key])
  @@index([workflowId])
  @@map("workflow_statuses")
}

// ==================== CUSTOM FIELDS ====================

// Organization-level custom field definition
model CustomFieldDefinition {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Scope: a field belongs to a Task Type (workflowId) OR is global (null → all tasks).
  // A task collects its type's fields + the global fields (cascade, like workflows).
  workflowId     String?
  workflow       StatusWorkflow?    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name           String // "Customer PO Number", "Equipment Model"
  key            String // "customer_po", "equipment_model"
  type           CustomFieldType
  options        Json? // for DROPDOWN: ["Option A", "Option B"]
  isRequired     Boolean            @default(false)
  position       Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  values         CustomFieldValue[]

  @@unique([organizationId, workflowId, key])
  @@index([organizationId])
  @@index([workflowId])
  @@map("custom_field_definitions")
}

// Custom field value for a specific task
model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  value        String // stored as string, parsed by type
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

// ==================== RECURRING TASKS ====================

// Template for automatically creating recurring tasks
model RecurringTaskTemplate {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Generated tasks land in this space and carry this Task Type, so they fit the
  // space-centric / type-driven model (not orphaned, org-level generic tasks).
  spaceId         String?
  space           CompanyLocation?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  workflowId      String?
  workflow        StatusWorkflow?     @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  priority        TaskPriority        @default(MEDIUM)
  locationLat     Float?
  locationLng     Float?
  locationAddress String?
  assigneeIds     Json? // array of user IDs to assign
  estimatedHours  Float?
  checklist       Json? // array of { text: string }
  frequency       RecurrenceFrequency
  customDays      Int? // for CUSTOM: every N days
  dayOfWeek       Int? // for WEEKLY/BIWEEKLY: 0=Sun, 1=Mon, etc.
  dayOfMonth      Int? // for MONTHLY: 1-31
  startDate       DateTime
  endDate         DateTime? // null = forever
  lastGeneratedAt DateTime?
  nextRunAt       DateTime?
  isActive        Boolean             @default(true)
  createdById     String
  createdBy       User                @relation("RecurringTaskCreator", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([nextRunAt, isActive])
  @@index([spaceId])
  @@index([workflowId])
  @@map("recurring_task_templates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVOICING & BILLING
// ═══════════════════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String // Auto-generated: INV-YYYY-XXXX
  status        InvoiceStatus @default(DRAFT)

  // The CUSTOMER-kind space this invoice bills (plain marker, no FK — mirrors
  // InvoiceItem.taskId/reportId). Null = ad-hoc invoice not tied to a space.
  spaceId String?

  // Client info (auto-filled from the space's contact fields at create time,
  // then editable — snapshotted so the invoice is stable if the space changes)
  clientName    String
  clientEmail   String?
  clientAddress String?

  // Amounts
  subtotal  Float  @default(0)
  taxRate   Float? // e.g., 0.15 for 15%
  taxAmount Float  @default(0)
  discount  Float  @default(0)
  total     Float  @default(0)
  currency  String @default("USD")

  // Dates
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  // Notes
  notes String?

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("InvoiceCreator", fields: [createdById], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber]) // backstop: no duplicate invoice numbers per org
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, spaceId]) // list a customer space's invoices fast
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  amount      Float  @default(0)

  // Optional link to task/service report
  taskId   String?
  reportId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ═══════════════════════════════════════════════════════════════════════════
//  IN-APP SUPPORT (tickets + conversation backbone)
//  Every support channel (web widget, mobile, email, live chat) writes to a
//  SupportTicket. Agents are platform staff (operator-key auth), so agent ids
//  are plain strings — NOT User FKs. Author of a message is disambiguated by
//  authorType, not a relation.
// ═══════════════════════════════════════════════════════════════════════════

enum SupportStatus {
  OPEN // new, awaiting first agent reply
  PENDING_AGENT // customer replied last — our turn
  PENDING_CUSTOMER // agent replied last — customer's turn
  RESOLVED // agent marked solved (customer may reopen)
  CLOSED // archived
}

enum SupportCategory {
  BILLING
  TECHNICAL
  HOWTO
  FEEDBACK
  OTHER
}

enum SupportChannel {
  WEB
  MOBILE
  EMAIL
  LIVE_CHAT
}

enum SupportAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("SupportCreatedBy", fields: [createdById], references: [id])

  subject  String
  category SupportCategory @default(OTHER)
  channel  SupportChannel  @default(WEB)
  status   SupportStatus   @default(OPEN)

  // Priority routing: lower = served first. Snapshot of the tier at creation.
  priority           Int     @default(4)
  planTierAtCreation String?

  // Agent (platform staff) currently owning the ticket — plain id, not a User FK.
  assignedAgentId String?
  // Support team that owns this ticket, stamped at creation by the routing resolver
  // (manual org pin > routing rule > null = unassigned triage queue). Plain id.
  assignedTeamId  String?

  // SLA (first response). Due date computed from tier's business-hours SLA.
  slaFirstResponseDueAt DateTime?
  firstRespondedAt      DateTime?
  slaBreached           Boolean   @default(false)

  lastCustomerMessageAt DateTime?
  lastAgentMessageAt    DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status]) // org-scoped ticket queries
  @@index([createdById, updatedAt]) // a customer's own ticket list (owner-scoped)
  @@index([status, priority, createdAt]) // agent inbox (priority routing order)
  @@index([assignedAgentId, status]) // an agent's assigned view
  @@index([assignedTeamId, status]) // a team's scoped queue
  @@index([slaBreached, slaFirstResponseDueAt]) // breach sweep / at-risk
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Author id: a User id for CUSTOMER, an agent handle for AGENT, null for SYSTEM.
  authorId       String?
  authorType     SupportAuthorType
  body           String
  attachments    Json              @default("[]") // SupportAttachment[]
  isInternalNote Boolean           @default(false) // agent-only; never delivered to the customer

  readByCustomerAt DateTime?
  readByAgentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ── Support Teams: books of business + dynamic routing ──────────────────────
// Platform-level (the SaaS support org), NOT customer-org scoped. Each team owns
// a slice of the customer base (by routing rules and/or manual org pins); agents
// see only their teams' queue + the unassigned triage queue, supervisors see all.

enum SupportTeamRole {
  MANAGER // manage the team's roster + reassign tickets within the team
  AGENT // handle the team's queue
}

model SupportTeam {
  id          String  @id @default(cuid())
  name        String
  color       String? // UI chip color, e.g. "#2563EB"
  description String?
  isActive    Boolean @default(true)

  members      SupportTeamMember[]
  routingRules SupportRoutingRule[]
  pinnedOrgs   Organization[]       @relation("OrgSupportTeam") // manual overrides

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_teams")
}

model SupportTeamMember {
  id             String          @id @default(cuid())
  teamId         String
  team           SupportTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // A PlatformUser id (not a hard FK so team membership survives independent of
  // the platform_users table lifecycle; resolved in the service layer).
  platformUserId String
  teamRole       SupportTeamRole @default(AGENT)

  createdAt DateTime @default(now())

  @@unique([teamId, platformUserId])
  @@index([platformUserId]) // resolve a caller's teams
  @@map("support_team_members")
}

model SupportRoutingRule {
  id     String      @id @default(cuid())
  teamId String
  team   SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name       String
  isActive   Boolean @default(true)
  order      Int     @default(0) // lower = evaluated first; first match wins
  conditions Json    @default("{}") // { planTier?, country?, state?, industry? } (RoutingConditions)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order]) // ordered rule evaluation
  @@map("support_routing_rules")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MEMBER-TO-MEMBER CHAT (1:1 DMs now; GROUP later)
// ═══════════════════════════════════════════════════════════════════════════

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ConversationType @default(DIRECT)
  title          String? // group name; DMs derive title from the other member
  // Stable key for a 1:1 thread (sorted userIds) so two people share ONE
  // conversation. Null for GROUP (multiple nulls are allowed by the unique idx).
  dmKey          String?
  createdById    String
  lastMessageAt  DateTime?

  // The shared space that authorizes a CROSS-ORG conversation. Null for the
  // ordinary in-org case. This is the reason the two people may talk, not a
  // cached verdict: every send re-resolves the share behind it, so revoking the
  // share freezes the thread with nothing to update here. For a cross-org row
  // `organizationId` is the space OWNER's org, deterministically, so both sides
  // upsert the same conversation instead of one thread each.
  originSpaceId String?

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dmKey]) // one DM per pair per org
  @@index([organizationId, lastMessageAt])
  @@index([originSpaceId]) // freeze/audit sweeps by share
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("ChatMessageSender", fields: [senderId], references: [id])
  body           String
  attachments    Json         @default("[]") // ChatAttachment[]
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
//  SaaS BILLING & SUBSCRIPTIONS
//  (org-level subscription state; distinct from the customer-facing Invoice
//   model above, which is orgs billing THEIR OWN clients for jobs.)
// ═══════════════════════════════════════════════════════════════════════════

enum PlanTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING // in 14-day free trial (no card yet)
  ACTIVE // paid & current
  PAST_DUE // payment failed, in dunning grace period
  CANCELED // canceled (access until currentPeriodEnd, then locked)
  INCOMPLETE // trial ended with no payment method → locked read-only
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// One subscription per organization. Seat quantities are derived from member
/// access (office = ADMIN + web members, field = mobile-only) and synced to Stripe.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String?            @unique
  planTier             PlanTier
  status               SubscriptionStatus @default(TRIALING)
  interval             BillingInterval    @default(MONTHLY)

  /// What this organization's bill last came to, in monthly EUR cents.
  /// Read for ONE decision: whether an annual change is an increase, which
  /// decides between charging the proration now and banking it. Comparing line
  /// counts cannot answer that — swapping a €29 module for a €9 one is fewer
  /// euros and the same number of lines.
  lastBilledCents   Int @default(0)
  officeSeats       Int @default(0)
  fieldSeats        Int @default(0) // external/freelancer field seats (€15)
  fieldInhouseSeats Int @default(0) // in-house/employed field seats (€9)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

/// Raw Stripe webhook events — for idempotency (unique stripeEventId) and audit.
model BillingEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  stripeEventId String    @unique
  type          String
  payload       Json?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@map("billing_events")
}

// ── Platform staff (company super-admins) ────────────────────────────────────
// HBC employees who run the SaaS via admin.hbcfield.com. Fully isolated from
// customer Users — a platform token is signed with a SEPARATE secret and can
// never act as a customer. RBAC via `role` (see @hbcfield/shared platformCan).
model PlatformUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                String    @default("SUPPORT") // OWNER | CONTROLLER | SUPPORT | BILLING
  isActive            Boolean   @default(true)
  twoFactorSecret     String? // TOTP (base32) — set once 2FA is enrolled
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("platform_users")
}

// ── Editable pricing (C2) — versioned price book, source of truth for display ──
// A published PricingConfig is the active price book. Editing writes a DRAFT
// version; publishing swaps `active`. Stripe price IDs are filled by the C3 sync
// layer — C2 never mutates Stripe.
model PricingConfig {
  id        String   @id @default(cuid())
  version   Int      @unique
  currency  String   @default("eur")
  active    Boolean  @default(false)
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  seatPrices   SeatPrice[]
  modulePrices ModulePrice[]

  @@map("pricing_configs")
}

model SeatPrice {
  id       String        @id @default(cuid())
  configId String
  config   PricingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  seatType      String // office | field | field_inhouse
  tier          String? // office only: starter | professional | business
  monthlyCents  Int
  annualCents   Int
  stripePriceId String? // set by C3

  @@index([configId])
  @@map("seat_prices")
}

model ModulePrice {
  id       String        @id @default(cuid())
  configId String
  config   PricingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  moduleKey     String
  monthlyCents  Int
  annualCents   Int
  billingScope  String  @default("per_org") // per_org | per_office_seat | per_space
  stripePriceId String? // set by C3

  @@index([configId])
  @@map("module_prices")
}

// ─── Public marketing blog (AI-authored via platform API/MCP) ───────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String // Markdown body
  coverUrl    String? // e.g. /api/v1/blog/images/<id> or any absolute URL
  author      String   @default("HBCField Team")
  tags        String[] @default([])
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model BlogImage {
  id        String   @id @default(cuid())
  mime      String
  fileName  String?
  data      Bytes // stored in DB: blog-scale images, durable, backed up with the DB
  createdAt DateTime @default(now())

  @@map("blog_images")
}

/// Lease deciding which replica runs a scheduled job.
///
/// NestJS starts a @Cron in every instance; without this a second replica runs
/// every schedule twice. Claimed and released with raw SQL from all four
/// services, so it deliberately carries no relations — see
/// packages/shared/src/scheduling/cron-lock.ts for why it is a lease row rather
/// than pg_advisory_lock (PgBouncer transaction pooling).
model CronLock {
  name        String    @id
  lockedUntil DateTime
  lockedBy    String
  lastRunAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("cron_locks")
}

// ═══════════════════════════════════════════════════════════════════════════
// THE PERSONNEL FILE
//
// Documents that belong to a PERSON, not to a task. Everything file-shaped in
// this system until now hung off a Task, a ServiceReport, a ShiftIssue or a
// WorkLog; a payslip belongs to none of those.
//
// Bytes are never stored here. A Document row carries a content-addressed
// object key and the SHA-256 of what is behind it, so the key is the integrity
// check and identical files are stored once — see
// packages/shared/src/storage/object-store.ts.
// ═══════════════════════════════════════════════════════════════════════════

/// How often a document type produces a new document — drives the list UI.
enum DocumentCadence {
  MONTHLY // a payslip: one per month, listed inside a year
  ANNUAL // a tax certificate: one per year
  ONE_OFF // a contract: no period at all
}

/// Who produced the document, which decides who may delete it.
enum DocumentDirection {
  ISSUED // company → member. Read and download, never delete.
  SUPPLIED // member → company. The member owns it and may replace it.
}

/// What the member must do before a document stops blocking them.
enum SignatureMode {
  NONE // reading is enough
  ACKNOWLEDGE // a recorded "I have read this", no drawn signature
  IN_APP // consent + drawn signature + seal
  WET_INK // refuses in-app signing: the law excludes some contract types
}

enum DocumentStatus {
  DRAFT // staged in a batch, invisible to the member
  /// The member uploaded it themselves and nobody has reviewed it yet. NOT
  /// accepted by the dispatch gate, which is the whole reason it is a status
  /// rather than a flag: an unverified licence cannot clear a requirement.
  PENDING_VERIFICATION
  REJECTED // a reviewer refused it; `rejectionReason` says why
  ISSUED
  AWAITING_SIGNATURE
  SIGNED // sealed and frozen
  EXPIRED // a credential past its date
  SUPERSEDED
  REVOKED
}

enum DocumentEventType {
  SUBMITTED // the member uploaded it
  ISSUED
  DELIVERED
  OPENED
  DOWNLOADED
  CONSENTED
  SIGNED
  SEALED
  ACKNOWLEDGED
  VERIFIED
  REJECTED
  /// A signer returned the document to an earlier step with a reason. Distinct
  /// from REJECTED, which ends a supplied document — this one keeps the chain
  /// alive and says why it went backwards.
  SENT_BACK
  REVOKED
  SUPERSEDED
}

/// A kind of document, defined per organization.
///
/// A CREDENTIAL is just a type with `isCredential` and an expiry — there is no
/// separate credentials table, because a driving licence is a document that
/// happens to run out. `requiredForWorkflowIds` is what turns it operational:
/// list a task type here and an expired credential removes the member from the
/// assignable pool for it.
model DocumentType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String // stable machine key, unique per org: 'payslip'
  label       String
  description String?
  cadence     DocumentCadence   @default(ONE_OFF)
  direction   DocumentDirection @default(ISSUED)

  /// Months to keep after issue; null = keep indefinitely. A property of the
  /// TYPE, never a global setting: Austrian employee records run ~3 years past
  /// termination, payroll far longer, a written reference thirty.
  retentionMonths Int?

  signatureMode SignatureMode @default(NONE)

  /// The signing route: an ordered list of roles, e.g.
  ///   [{"role":"MEMBER"},{"role":"RESPONSIBLE"},{"role":"CUSTOMER"}]
  ///
  /// Null means today's behaviour exactly — one signature, by the member. JSON
  /// rather than a table because it is three rows of config, and the shape is
  /// owned and validated in packages/shared/src/documents/route.ts.
  signerRoute Json?

  isCredential           Boolean  @default(false)
  hasExpiry              Boolean  @default(false)
  requiredForWorkflowIds String[] @default([])

  /// Whether members are EXPECTED to provide one, as opposed to merely allowed
  /// to. A board built from documents cannot show the technician who uploaded
  /// nothing; the expectation has to be a record before the absence can be.
  requiredFromAll     Boolean  @default(false)
  requiredFromRoleIds String[] @default([])

  /// Whether the scanner asks for the back as well. A property of the DOCUMENT,
  /// not of what it proves: European ID cards and driving licences carry the
  /// machine-readable zone on the back, passports carry it on the photo page,
  /// and a paper certificate has nothing on its reverse at all.
  twoSided Boolean @default(false)

  /// The frame the scanner draws: CARD (ID-1), PASSPORT (ID-3) or PAGE (A4).
  /// Not decoration — a document held to fit the wrong frame sits further from
  /// the lens, and the pixel size of the machine-readable zone is what decides
  /// whether it can be read at all.
  scanShape String @default("CARD")

  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  templates DocumentTemplate[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  // The dispatch gate's first question is "does this org gate anything at all?".
  @@index([organizationId, isCredential])
  @@map("document_types")
}

/// A contract template, bound to a role and a job title.
///
/// Selection keys off the invitation, which already carries `memberRoleId` and
/// `position` — no new invitation fields were needed for this.
model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  typeId String
  type   DocumentType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  name String
  /// Body with {{merge.tokens}} — see packages/shared/src/documents/merge-fields.ts
  body String @db.Text

  /// Which members this applies to. Both null = the organization's default.
  appliesToRoleId   String?
  appliesToRole     AccessRole? @relation(fields: [appliesToRoleId], references: [id], onDelete: SetNull)
  appliesToPosition String?

  signatureMode SignatureMode @default(IN_APP)

  /// Days an unsigned contract stays signable. An offer that can still be
  /// signed six weeks later is a liability, and a deadline is fairer anyway.
  offerValidDays Int? @default(14)

  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([organizationId, isActive])
  @@index([organizationId, appliesToRoleId, appliesToPosition])
  @@map("document_templates")
}

/// One document belonging to one member.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  typeId String
  type   DocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title String

  /// Present only for cadenced types. Drives the year/month grouping.
  periodYear  Int?
  periodMonth Int?

  /// Content-addressed key — {orgId}/documents/{sha[0:2]}/{sha}.ext
  storageKey String
  /// The document as ISSUED, before any signature.
  ///
  /// Each signing re-renders from here: original + ONE signature block + ONE
  /// certificate. Without it the only way to add a signature is to append
  /// another pair of pages, so three signers would produce six.
  originalKey    String?
  originalSha256 String?
  sha256     String
  sizeBytes  Int
  mimeType   String @default("application/pdf")

  status DocumentStatus @default(ISSUED)

  issuedById String?
  issuedBy   User?   @relation("DocumentsIssued", fields: [issuedById], references: [id], onDelete: SetNull)

  issuedAt      DateTime  @default(now())
  /// The notification was accepted for delivery. A LINK IS NOT DELIVERY — the
  /// document must be permanently available to the member and receipt provable.
  deliveredAt   DateTime?
  firstOpenedAt DateTime?

  /// Credentials only.
  expiresOn    DateTime? @db.Date
  verifiedAt   DateTime?
  verifiedById String?

  /// Why a member-supplied document was refused, in the reviewer's words. On
  /// the row and not only in the event trail: the member's own list has to show
  /// it, and "rejected" with no reason means uploading the same photo again.
  rejectionReason String?

  /// What was READ off the document, when it was scanned rather than typed.
  ///
  /// `scanVerdict` is the summary a reviewer sees first; `scanChecks` is what
  /// it is made of. The four extracted columns are here rather than only inside
  /// `scanData` because they are QUERIED — the document number to find the same
  /// document filed twice, the name and date of birth to compare against the
  /// member record.
  scanFormat     String?
  scanVerdict    String?
  scanData       Json?
  scanChecks     Json?
  holderName     String?
  documentNumber String?
  dateOfBirth    DateTime? @db.Date
  issuingState   String?

  /// Null means keep indefinitely; see DocumentType.retentionMonths.
  retentionUntil DateTime?

  /// A renewal points at what it replaces, so history stays readable.
  supersedesId String?   @unique
  supersedes   Document? @relation("DocumentSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Document? @relation("DocumentSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Superseded by `signatures` — a document can now carry a chain. Kept as a
  /// list so the old one-signature reads become the first element.
  signatures DocumentSignature[]
  signers    DocumentSigner[]
  events    DocumentEvent[]

  // The member's own list: their documents, by type, newest year first.
  @@index([userId, typeId, periodYear])
  // The admin's list and the batch view.
  @@index([organizationId, status])
  // "Has this exact document already been filed here, by anybody?"
  @@index([organizationId, documentNumber])
  // The compliance board: what expires soon, org-wide.
  @@index([organizationId, expiresOn])
  // Dedup: the same bytes issued to thirty people are one object, but each
  // member still gets their own row.
  @@index([organizationId, sha256])
  @@map("documents")
}

/// Everything captured at the moment of signing.
///
/// A drawn squiggle alone is the weakest tier eIDAS recognises. What lifts it
/// is this row: linked to an identified signer under sole control, with any
/// later change detectable. If `hashAfter` still matches the stored bytes, the
/// document provably has not been altered since it was sealed.
/// One step of a document's signing route: who is expected to sign, and whether
/// they have. The plan and the state; the signature itself is a separate row.
enum DocumentSignerRole {
  MEMBER /// whoever the document was issued to
  RESPONSIBLE /// resolved through the member's `approve` routing
  ORG_REPRESENTATIVE /// somebody signing on behalf of the organization
  CUSTOMER /// the space's client — the only role that can be external
}

enum DocumentSignerStatus {
  PENDING
  SIGNED
  SKIPPED /// the route asked for a signer this document has none of
}

/// A step in the chain, resolved to a real person when the document is issued.
///
/// Frozen at issue on purpose: a member changing manager next month must not
/// re-route a document already in flight, and the certificate has to be able to
/// say who was asked, not who would be asked today.
model DocumentSigner {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Position in the route. 1-based, and the order signatures are collected in.
  order Int
  role  DocumentSignerRole

  /// Resolved signer. A member for the internal roles, a customer for CUSTOMER.
  userId     String?
  user       User?     @relation("DocumentSignerUser", fields: [userId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Where a signing link was sent, when the customer has no account.
  email String?

  status     DocumentSignerStatus @default(PENDING)

  /// The counterparty's display name when they are not a member and not a CRM
  /// record — a space's contact, or somebody typed in for this one document.
  contactName String?

  /// When this signer first opened THIS document. Evidence, not a gate: forcing
  /// somebody to open ten identical time sheets buys clicking-through, which is
  /// a worse signature than the honest one. The certificate reports it.
  openedAt DateTime?
  notifiedAt DateTime?
  signedAt   DateTime?

  /// Phase 4. Hashed like every other token here — the plaintext is only ever
  /// in the link, never at rest.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?

  signature DocumentSignature?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One signer per position: the route cannot fork or duplicate a step.
  @@unique([documentId, order])
  /// "What is waiting for me" — the question every signer's home screen asks.
  @@index([userId, status])
  @@index([documentId, status])
  @@map("document_signers")
}

model DocumentSignature {
  id String @id @default(cuid())

  /// NOT unique any more. A document can carry a chain of signatures — worker,
  /// then their responsible, then the client — and the unique constraint was
  /// what made that impossible. One signature per STEP is enforced on signerId
  /// instead, which is the guarantee that actually matters.
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The step this signature completes. Null only for documents issued before
  /// routes existed, which have exactly one signature and no signer rows.
  signerId String?         @unique
  signer   DocumentSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  /// A signature is by a MEMBER or by a CLIENT, never both and never neither.
  ///
  /// This was `userId String` with a required relation, which quietly meant only
  /// somebody with a login could ever sign. A client countersigning by emailed
  /// link has no user row, and inventing one for them would put a fake member in
  /// every roster, seat count and permission check in the product.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// What a link signer typed about themselves. The only identity this flow
  /// has, so it is recorded verbatim and the certificate says where it came
  /// from rather than dressing it up as an authenticated session.
  signerName String?
  signerRole String?

  /// One ceremony, many documents. Eleven time sheets signed in one sitting
  /// share this id, and each certificate says so — a document signed in a batch
  /// is weaker evidence than one signed alone, and hiding that would make the
  /// whole certificate worth less.
  batchId String?

  /// The drawing lives in object storage, NOT in this row. Three columns in
  /// this schema already hold base64 PNGs inline; that is the mistake this
  /// deliberately does not repeat.
  signatureKey    String
  signatureSha256 String

  /// Consent is its own recorded act, separate from the signature.
  consentText String   @db.Text
  consentAt   DateTime

  signedAt DateTime @default(now())

  hashBefore String
  hashAfter  String
  sealedAt   DateTime?

  /// Makes signing safely retryable: a dropped connection returns the existing
  /// seal instead of signing a second time.
  idempotencyKey String @unique

  @@index([userId])
  /// The chain, in order — every read of a sealed document asks for this.
  @@index([documentId, signedAt])
  @@map("document_signatures")
}

/// One way in, for a client who has no login here.
///
/// The token addresses a CLIENT, not a document. That single choice is what
/// lets one signature cover eleven time sheets, and what makes a document
/// issued tomorrow appear on the link somebody bookmarked yesterday — the
/// alternative was one email, one link and one ceremony per document, which is
/// how you teach a client to ignore your email.
///
/// It expires, because it is a bearer credential and an immortal one sitting in
/// a forwarded mailbox is permanent access to a company's paperwork. What is
/// durable is not the token but the EMAIL ADDRESS: an expired link offers to
/// send a new one, and only ever to the address already on file.
model CustomerSignLink {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /**
   * WHO the link is for — an address, not a record.
   *
   * Keyed on the email because that is the only identity every counterparty
   * has. A CRM client has a row; a client space has a contact; somebody typed
   * in for one document has neither. Keying on `customerId` served exactly one
   * of those three and left the other two unable to hold a link at all.
   *
   * It is also the right scope. A link resolves the signer rows addressed to
   * THIS address, so a one-off contact sees the one document sent to them and
   * never a client's history — which keying on a client record could not
   * express.
   */
  email String

  /// The CRM client, when there is one. Provenance only: never what the link
  /// resolves by, so a client's address changing tomorrow cannot redirect a
  /// document already in flight.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// SHA-256 of the token. The plaintext exists only in the email that carried
  /// it — a database dump must never hand somebody a working signing link, the
  /// mistake already made with invitation codes where the plaintext sits beside
  /// the hash.
  tokenHash String   @unique
  expiresAt DateTime

  /// Rate limiting without new infrastructure: "send me a new link" refuses if
  /// this is recent, so the form cannot be used to mail-bomb a client.
  lastSentAt   DateTime?
  sentCount    Int       @default(0)
  /// Whether anybody has actually followed it — the difference between "sent"
  /// and "seen" on the admin register, and the difference between chasing a
  /// client and chasing your mail provider.
  firstOpenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live link per client per organisation. Re-issuing REPLACES the hash,
  /// which kills the previous link: two live links is two people able to sign
  /// as the client.
  /// One live link per address per organisation. Re-issuing REPLACES the hash,
  /// which kills the previous link: two live links is two people able to sign
  /// as the same counterparty.
  @@unique([organizationId, email])
  @@index([expiresAt])
  @@map("customer_sign_links")
}

/// The evidence trail. Append-only by contract: no update path is written and
/// no service method exposes one.
model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type DocumentEventType
  at   DateTime          @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  ip         String?
  userAgent  String?
  appVersion String?
  lat        Float?
  lng        Float?
  meta       Json?

  @@index([documentId, at])
  @@map("document_events")
}
