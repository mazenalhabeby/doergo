// ==================== MONITORING MODELS ====================

// Activity log for audit trail
model ActivityLog {
  id        String @id @default(cuid())
  // Free-form action string (e.g. "USER_LOGIN", "MEMBER_ROLE_CHANGED",
  // "TASK_DELETED", "LOCATIONS_UPDATED") so any mutation can be audited without
  // an enum migration. The gateway audit interceptor writes these.
  eventType String

  // Who performed the action
  userId String?
  user   User?   @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  // Who was affected (e.g., user being assigned, deleted)
  targetUserId String?
  targetUser   User?   @relation("ActivityLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Resource context
  resourceType String? // "task", "user", "report", "timeEntry", etc.
  resourceId   String?

  // Additional context
  metadata  Json? // { previousStatus, newStatus, reason, etc. }
  ipAddress String?
  userAgent String?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  // Serves the per-entity audit trail: WHERE resourceId = ? ORDER BY createdAt DESC.
  @@index([resourceId, createdAt])
  @@map("activity_logs")
}

// System health metrics (time-series data)
model HealthMetric {
  id          String   @id @default(cuid())
  serviceName String // "gateway", "auth-service", "task-service", etc.
  metricType  String // "latency", "error_rate", "request_count", "memory_usage"
  value       Float
  timestamp   DateTime @default(now())
  metadata    Json? // { endpoint, statusCode, errorMessage, etc. }

  @@index([serviceName, timestamp])
  @@index([metricType, timestamp])
  @@map("health_metrics")
}

// Notification delivery tracking
model NotificationDelivery {
  id      String              @id @default(cuid())
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  // Recipient
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Event that triggered the notification
  eventType String // "task.assigned", "task.completed", "alert.raised", etc.
  payload   Json? // The notification content/data

  // Delivery tracking
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  retryCount    Int       @default(0)
  // In-app inbox read state (null = unread). Powers the notification bell.
  readAt        DateTime?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([channel, status])
  @@index([eventType])
  // Retention sweep filters on createdAt alone — index it (H4).
  @@index([createdAt])
  @@map("notification_deliveries")
}

// Real-time alerts
model Alert {
  id       String        @id @default(cuid())
  type     String // "technician_offline", "task_overdue", "geofence_violation", "high_error_rate"
  severity AlertSeverity @default(WARNING)
