  approvedBy      User?     @relation("TimeOffApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String? // If rejected, reason why

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedById])
  @@index([technicianId, status, startDate]) // no-show sweep: approved leave per worker (P8)
