// ==================== PROJECT MANAGEMENT ====================

// Phase or milestone for grouping tasks
model Phase {
  id             String       @id @default(cuid())
  name           String
  description    String?
  color          String       @default("#3b82f6")
  type           String       @default("phase") // "phase" or "milestone"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * The space this belongs to.
   *
   * NULL means organization-wide — how every one of these worked before spaces
   * owned anything, and what existing rows stay. Set means it belongs to that
   * space, and the modules that govern it are that space's rather than the
   * organization's.
   *
   * Nullable on purpose: making it required would have forced every existing
   * row into some arbitrary space, and "belongs everywhere" is a real answer
   * for an organization that runs one backlog across its sites.
   */
  spaceId        String?
  space          CompanyLocation? @relation("SpacePhases", fields: [spaceId], references: [id], onDelete: SetNull)
  startDate      DateTime?
  endDate        DateTime?
  position       Int          @default(0)
  isActive       Boolean      @default(true)
