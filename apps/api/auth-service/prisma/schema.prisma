generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN // Organization owner/admin - full control
  EMPLOYEE // Everyone else. "Manager" capability is now the canViewAllTasks /
  // canAssignTasks access flags, not a role. (MANAGER + legacy
  // CLIENT/DISPATCHER/TECHNICIAN retired 2026-07-16.)
}

// Platform access restriction
enum Platform {
  WEB // Web app only
  MOBILE // Mobile app only
  BOTH // Both platforms
}

// Access level for organization delegation
enum AccessLevel {
  NONE // No access - manager sees nothing
  TASKS_ONLY // Can view tasks only
  TASKS_ASSIGN // Can view tasks + assign workers
  FULL // Can view everything + assign
}

enum TaskStatus {
  DRAFT
  NEW
  ASSIGNED
  ACCEPTED // Technician acknowledges the assigned task
  EN_ROUTE // Technician is traveling to the job location
  ARRIVED // Technician has arrived at the location
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELED
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_TOGGLED
  CHECKLIST_ITEM_REMOVED
}

enum TaskAssigneeRole {
  LEAD
  MEMBER
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum ReportAttachmentType {
  BEFORE // Photo taken before work started
  AFTER // Photo taken after work completed
}

// Time entry status for attendance tracking
enum TimeEntryStatus {
  CLOCKED_IN // Currently clocked in
  CLOCKED_OUT // Normal clock out
  AUTO_OUT // System auto clock-out (midnight, etc.)
}

// Time entry approval status
enum ApprovalStatus {
  PENDING // Awaiting manager review
  APPROVED // Manager approved
  REJECTED // Manager rejected
  AUTO // Auto-approved (e.g., within geofence, normal hours)
}

// Break type for attendance tracking
enum BreakType {
  LUNCH // Lunch break (typically 30-60 min)
  SHORT // Short break (typically 10-15 min)
  OTHER // Other break type
}

// Time-off request status
enum TimeOffStatus {
  PENDING // Awaiting manager approval
  APPROVED // Manager approved
  REJECTED // Manager rejected
  CANCELED // Technician canceled the request
}

// Invitation status
enum InvitationStatus {
  PENDING // Created, waiting to be used
  ACCEPTED // Used by a new user
  EXPIRED // Past expiry date
  REVOKED // Manually canceled by creator/admin
}

// Organization join policy
enum JoinPolicy {
  OPEN // Anyone with org code can request to join
  INVITE_ONLY // Only via one-time invitation codes
  CLOSED // No new members
}

// Join request status
enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ==================== MONITORING ENUMS ====================

// Monitoring event types for activity logging
enum MonitoringEventType {
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_DELETED
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  CLOCK_IN
  CLOCK_OUT
  GEOFENCE_VIOLATION
  TECHNICIAN_OFFLINE
  TASK_OVERDUE
  API_ERROR
  SERVICE_DOWN
  SERVICE_UP
}

// Alert severity levels
enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// Alert status
enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// Notification delivery channel
enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  SOCKET
}

// Notification delivery status
enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum OvertimeRequestStatus {
  PENDING_TECHNICIAN // Notification sent, waiting for tech to respond
  PENDING_APPROVAL // Technician said YES, waiting for team leader
  APPROVED // Team leader approved, overtime active
  REJECTED // Team leader rejected
  EXPIRED_NO_RESPONSE // Technician didn't respond in time
  EXPIRED_NO_APPROVAL // Team leader didn't respond in time
  COMPLETED // Overtime ended normally
  CANCELED // Technician declined
}

enum OvertimeApprovalMethod {
  REMOTE // Team leader approved via push notification on their device
  SIGNATURE // Team leader signed on the technician's phone
}

// Task creation scope — controls who the user can create tasks for
enum TaskCreationScope {
  NONE // Cannot create tasks
  SELF // Can only create tasks assigned to self
  SPACE // Can create tasks in spaces the user is assigned to
  ORG // Can create tasks for anyone in the organization
}

// Custom field types for organization-specific task fields
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
  EMAIL
}

// Recurrence frequency for recurring task templates
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

// Task dependency types (project management)
enum DependencyType {
  FINISH_TO_START // Predecessor must finish before successor starts
  START_TO_START // Predecessor must start before successor starts
  FINISH_TO_FINISH // Predecessor must finish before successor finishes
  START_TO_FINISH // Predecessor must start before successor finishes
}

// Sprint status for agile workflow
enum SprintStatus {
  PLANNING // Sprint is being planned
  ACTIVE // Sprint is in progress
  COMPLETED // Sprint is completed
}

// Models

// Custom organization role with JSON permissions
model OrgRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  color          String?      @default("#6b7280")
  isSystem       Boolean      @default(false)
  legacyRole     String? // Maps to Role enum for backward compat (ADMIN, DISPATCHER, TECHNICIAN)
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  permissions    Json // { canCreateTasks: bool, canViewAllTasks: bool, ... }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  invitations    Invitation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("org_roles")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization profile
  industry     String? // e.g. "HVAC", "Plumbing", "Electrical", "General Contracting"
  address      String? // Legacy single-line address (kept for back-compat)
  addressLine1 String? // Street address
  addressLine2 String? // Suite / floor / unit (optional)
  city         String?
  state        String? // State / province / region
  postalCode   String? // ZIP / postal code
  country      String? // ISO 3166-1 alpha-2 code (e.g. "DE", "AT")
  phone        String? // Contact phone
  email        String? // Contact email (org-level, not user)
  website      String? // Website URL
  timezone     String? @default("Europe/Vienna") // IANA timezone
  logoUrl      String? // Organization logo

  // Join system
  joinCode     String? // Plaintext join code (displayed to admin)
  joinCodeHash String?    @unique // SHA-256 hash of persistent org join code
  joinPolicy   JoinPolicy @default(INVITE_ONLY)

  // Organization settings (JSON blobs for flexible config)
  profileBadges     Json? // { showRole, showWorkMode, showType, showSpecialty }
  notificationPrefs Json? // { emailOnTaskCreate, emailOnTaskComplete, emailOnJoinRequest, pushEnabled }
  securitySettings  Json? // { sessionTimeoutHours, requireStrongPassword, maxFailedAttempts }
  enabledModules    Json? // e.g. ["story_points", "epics", "sprints", "phases", "custom_fields", "time_tracking"]

  // ── SaaS billing (denormalized for fast guard reads; Subscription + Stripe are source of truth) ──
  stripeCustomerId  String?            @unique
  planTier          PlanTier? // null = no paid plan chosen yet
  subStatus         SubscriptionStatus @default(TRIALING)
  billingInterval   BillingInterval    @default(MONTHLY)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  billingEmail      String?
  vatId             String?

  users User[]
  tasks Task[]

  // Custom roles
  orgRoles OrgRole[]

  // Organization delegation relationships
  grantedAccess  OrganizationAccess[] @relation("Grantor") // Access this org has granted to others
  receivedAccess OrganizationAccess[] @relation("Grantee") // Access this org has received from others

  // Asset management
  assetCategories AssetCategory[]
  assets          Asset[]

  // Service reports
  serviceReports ServiceReport[]

  // Company locations for full-time technician attendance
  companyLocations CompanyLocation[]

  // Time entries for attendance tracking
  timeEntries TimeEntry[]

  // Invitations
  invitations Invitation[]

  // Notification routing (per-employee watchers)
  notificationWatches NotificationWatch[]

  // Join requests
  joinRequests JoinRequest[]

  // Project management
  phases  Phase[]
  sprints Sprint[]
  epics   Epic[]

  // Agile
  definitionsOfDone DefinitionOfDone[]

  // Custom workflows & fields
  workflows              StatusWorkflow[]
  customFieldDefinitions CustomFieldDefinition[]

  // Recurring tasks
  recurringTemplates RecurringTaskTemplate[]

  // Monitoring
  activityLogs           ActivityLog[]
  notificationDeliveries NotificationDelivery[]
  alerts                 Alert[]
  dailyMetrics           DailyMetric[]
  overtimeRequests       OvertimeRequest[]

  // Invoicing
  invoices Invoice[]

  supportTickets SupportTicket[]

  conversations Conversation[]

  // Schedule templates
  scheduleTemplates ScheduleTemplate[]

  // SaaS subscription / billing
  subscription  Subscription?
  billingEvents BillingEvent[]

  @@map("organizations")
}

// Many-to-many delegation: Org A can manage Org B (if B grants access)
model OrganizationAccess {
  id String @id @default(cuid())

  // Who is granting access (the managed org)
  grantorOrgId String
  grantorOrg   Organization @relation("Grantor", fields: [grantorOrgId], references: [id], onDelete: Cascade)

  // Who is receiving access (the manager org)
  granteeOrgId String
  granteeOrg   Organization @relation("Grantee", fields: [granteeOrgId], references: [id], onDelete: Cascade)

  // Access level
  accessLevel AccessLevel @default(NONE)

  // Granular permissions (for fine-tuned control)
  canViewTasks     Boolean @default(false)
  canAssignWorkers Boolean @default(false)
  canViewWorkers   Boolean @default(false)
  canViewTracking  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each org pair can only have one access record
  @@unique([grantorOrgId, granteeOrgId])
  @@index([grantorOrgId])
  @@index([granteeOrgId])
  @@map("organization_access")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Security: Account lockout fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Permission fields (granular access control)
  canCreateTasks    Boolean           @default(false) // Can create new tasks
  taskCreationScope TaskCreationScope @default(NONE) // Granular task creation scope
  canViewAllTasks   Boolean           @default(false) // Can view all org tasks (vs only assigned/created)
  canAssignTasks    Boolean           @default(false) // Can assign tasks to technicians
  canManageUsers    Boolean           @default(false) // Can manage users in organization
  allowRemote       Boolean           @default(false) // May clock in remotely (WFH/anywhere), geofence-exempt
  presence          String? // Manual availability override: AVAILABLE | BUSY | AWAY (null = auto from task/clock)
  lastActiveAt      DateTime? // Last time the user made an authenticated request (throttled ~1/min) → online/last-seen
  // Contact directory / access — open within the org by default; admins restrict
  // via the Access Builder (canContact:false, or contactScope SELECTED).
  contactable       Boolean           @default(true) // Reachable in the org contacts directory
  contactScope      String            @default("ALL") // Who this member may contact: NONE | ALL | SELECTED
  contactAllowedIds String[]          @default([]) // When SELECTED: the specific contact user IDs this member may reach
  // Per-recipient notification opt-outs by category, e.g. { "attendance": false }.
  // Missing/true = subscribed. Filters what THIS user receives (see NotificationWatch).
  notificationPrefs Json?

  // Worker configuration
  position          String? // Free-form: "technician", "driver", "sales", "office_manager"
  scheduleType      String? @default("NONE") // "FIXED", "FLEXIBLE", "NONE"
  monthlyHourBudget Float? // For FLEXIBLE: target hours per month (e.g., 160)
  enabledModules    Json? // Mobile modules: ["tasks", "clock", "time_off"]

  // Employee fields
  specialty    String? // e.g., "Electrical", "Plumbing", "Mechanical", "General"
  rating       Float?  @default(5.0) // Average rating (1-5)
  ratingCount  Int?    @default(0) // Number of ratings received
  maxDailyJobs Int?    @default(5) // Maximum jobs per day

  // Profile avatar
  avatarUrl String?

  // Profile badge visibility override (null = use org default)
  // JSON: { showRole, showWorkMode, showType, showSpecialty }
  profileBadges Json?

  // Onboarding flag (false = orphan user needs to complete onboarding wizard)
  onboardingCompleted Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Custom role assignment
  orgRoleId String?
  orgRole   OrgRole? @relation(fields: [orgRoleId], references: [id], onDelete: SetNull)

  createdTasks        Task[]                 @relation("TaskCreator")
  assignedTasks       Task[]                 @relation("TaskAssignee")
  taskAssignments     TaskAssignee[]         @relation("TaskAssignees")
  comments            Comment[]
  attachments         Attachment[]
  taskEvents          TaskEvent[]
  lastLocation        WorkerLastLocation?
  locationHistory     LocationHistory[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  serviceReports      ServiceReport[]
  assignments         TechnicianAssignment[] // Technician location assignments
  timeEntries         TimeEntry[] // Clock-in/clock-out records
  approvedTimeEntries TimeEntry[]            @relation("ApprovedTimeEntries") // Time entries approved by this user
  editedTimeEntries   TimeEntry[]            @relation("EditedTimeEntries") // Time entries edited by this user

  // Monitoring
  activityLogs           ActivityLog[]          @relation("ActivityLogUser") // Activity performed by this user
  targetedActivityLogs   ActivityLog[]          @relation("ActivityLogTarget") // Activity targeting this user
  notificationDeliveries NotificationDelivery[] // Notifications sent to this user
  alerts                 Alert[] // Alerts related to this user

  // Push notifications
  pushTokens UserPushToken[] // Device push tokens for notifications

  // Availability management
  schedules        TechnicianSchedule[] // Weekly recurring schedule
  timeOffRequests  TimeOff[]            @relation("TechnicianTimeOff") // Time-off requests submitted
  approvedTimeOffs TimeOff[]            @relation("TimeOffApprover") // Time-off requests approved by this user

  // Invitations
  createdInvitations Invitation[] @relation("InvitationCreator") // Invitations created by this user

  // Join requests
  joinRequests         JoinRequest[] @relation("UserJoinRequests") // Join requests submitted by this user
  reviewedJoinRequests JoinRequest[] @relation("JoinRequestReviewer") // Join requests reviewed by this user

  // Overtime
  overtimeRequests         OvertimeRequest[] @relation("TechnicianOvertime")
  approvedOvertimeRequests OvertimeRequest[] @relation("OvertimeApprover")

  // Recurring tasks
  recurringTemplates RecurringTaskTemplate[] @relation("RecurringTaskCreator")

  // Invoices
  createdInvoices Invoice[] @relation("InvoiceCreator")

  // Support tickets this user opened (assigned agents are platform staff, not Users)
  supportTickets SupportTicket[] @relation("SupportCreatedBy")

  // Member-to-member chat
  chatMemberships ConversationMember[]
  chatMessages    Message[]            @relation("ChatMessageSender")

  // Notification routing: who is watched by whom (per-employee override)
  watchedBy NotificationWatch[] @relation("WatchSubject") // managers watching THIS user
  watching  NotificationWatch[] @relation("WatchWatcher") // users THIS manager watches

  @@index([organizationId])
  @@index([role])
  @@index([email])
  @@index([orgRoleId])
  @@index([organizationId, role, isActive]) // list technicians/members in org
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // Store SHA-256 hash, not plain token
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Grace period fields for handling concurrent refresh requests
  usedAt              DateTime? // When the token was first used (null = not used yet)
  replacedByTokenHash String? // Hash of the new token that replaced this one
  cachedAccessToken   String? // Cached access token to return during grace period
  cachedRefreshToken  String? // Cached refresh token to return during grace period (temporary, deleted after grace period)

  // Device/session tracking
  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([usedAt]) // For cleanup of old used tokens
  @@index([expiresAt]) // For expired token cleanup
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // Store SHA-256 hash, not plain token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// Push notification tokens for mobile devices
model UserPushToken {
  id        String   @id @default(cuid())
  token     String   @unique // Expo push token (e.g., ExponentPushToken[xxx])
  platform  String // 'ios' | 'android' | 'web'
  deviceId  String? // Optional device identifier for deduplication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_push_tokens")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         String       @default("NEW")
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?

  // Custom workflow association
  workflowId String?
  workflow   StatusWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  // Route tracking fields
  routeStartedAt DateTime? // When EN_ROUTE started
  routeEndedAt   DateTime? // When ARRIVED
  routeDistance  Float? // Total distance in meters

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  // Optional link to space (CompanyLocation) for space-centric workflows
  spaceId String?
  space   CompanyLocation? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Optional link to asset for maintenance history
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Subtask hierarchy
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")
  depth    Int     @default(0) // Nesting level (0 = root, max 5)
  position Int     @default(0) // Order within siblings

  // Agile fields
  storyPoints Int? // Fibonacci: 1,2,3,5,8,13,21

  // Phase, Sprint & Epic associations
  phaseId  String?
  phase    Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId   String?
  epic     Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)

  // Dependencies
  predecessors TaskDependency[] @relation("DependencySuccessor")
  successors   TaskDependency[] @relation("DependencyPredecessor")

  comments        Comment[]
  attachments     Attachment[]
  events          TaskEvent[]
  locationHistory LocationHistory[]
  serviceReport   ServiceReport?
  assignees       TaskAssignee[]
  checklistItems  ChecklistItem[]
  customFields    CustomFieldValue[]

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([assetId])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([assignedToId, status]) // technician task stats groupBy, suggested technicians _count
  @@index([dueDate]) // due date filtering/sorting
  @@index([parentId]) // subtask queries
  @@index([phaseId]) // phase filtering
  @@index([sprintId]) // sprint filtering
  @@index([epicId]) // epic filtering
  @@index([workflowId]) // workflow filtering
  @@index([spaceId]) // space filtering
  @@index([organizationId, spaceId, status]) // space + status filtering
  @@map("tasks")
}

model TaskAssignee {
  id        String           @id @default(cuid())
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("TaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  role      TaskAssigneeRole @default(MEMBER)
  createdAt DateTime         @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text        String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([taskId, position])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Attachment {
  id        String         @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  AttachmentType
  fileSize  Int
  createdAt DateTime       @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

model TaskEvent {
  id        String        @id @default(cuid())
  eventType TaskEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([eventType])
  @@index([createdAt])
  @@index([taskId, createdAt]) // timeline queries
  @@map("task_events")
}

model WorkerLastLocation {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_last_locations")
}

// Location history for route tracking during EN_ROUTE status
model LocationHistory {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([taskId, timestamp])
  @@map("location_history")
}

// Dynamic category created by organization (e.g., "HVAC", "Electrical", "Plumbing")
model AssetCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  types  AssetType[]
  assets Asset[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("asset_categories")
}

// Dynamic type within a category (e.g., under HVAC: "Air Conditioner", "Heater")
model AssetType {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  assets Asset[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("asset_types")
}

// The actual equipment/asset
model Asset {
  id           String  @id @default(cuid())
  name         String
  serialNumber String?
  model        String?
  manufacturer String?

  status AssetStatus @default(ACTIVE)

  installDate    DateTime?
  warrantyExpiry DateTime?

  locationAddress String?
  locationLat     Float?
  locationLng     Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  typeId String?
  type   AssetType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  // Tasks linked to this asset (maintenance history)
  tasks          Task[]
  serviceReports ServiceReport[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([typeId])
  @@index([status])
  @@index([serialNumber])
  @@map("assets")
}

// Service report created when technician completes a task
model ServiceReport {
  id String @id @default(cuid())

  // Link to task (one-to-one)
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Link to asset (denormalized for faster history queries)
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Work details
  summary       String // Brief summary of work done
  workPerformed String? // Detailed description
  workDuration  Int // Duration in seconds (from mobile timer)

  // Signatures (base64 encoded PNG or URL)
  technicianSignature String? @db.Text
  customerSignature   String? @db.Text
  customerName        String? // Who signed

  // Metadata
  completedAt   DateTime
  completedById String
  completedBy   User     @relation(fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attachments ReportAttachment[]
  partsUsed   PartUsed[]

  // Organization scope (for multi-tenant queries)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId])
  @@index([assetId])
  @@index([completedAt])
  @@index([organizationId])
  @@index([completedById])
  @@index([organizationId, completedAt])
  @@map("service_reports")
}

// Attachment for service report (before/after photos)
model ReportAttachment {
  id String @id @default(cuid())

  reportId String
  report   ServiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  type     ReportAttachmentType // BEFORE or AFTER
  fileName String
  fileUrl  String
  fileSize Int // bytes
  caption  String? // Optional description

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_attachments")
}

// Parts/materials used in service
model PartUsed {
  id String @id @default(cuid())

  reportId String
  report   ServiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  name       String // "Air Filter", "Compressor Belt"
  partNumber String? // Optional SKU/part number
  quantity   Int     @default(1)
  unitCost   Float? // Optional cost per unit
  notes      String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("parts_used")
}

// A "space" — either a physical location (lat/lng set, used for attendance
// geofencing) or a logical workspace/project (no coordinates). Every task
// belongs to a space; modules + workflow are configured per space.
model CompanyLocation {
  id             String  @id @default(cuid())
  name           String // "Main Office", "Warehouse A", "General"
  address        String? // Full address string
  lat            Float? // Latitude (only for physical locations / attendance)
  lng            Float? // Longitude (only for physical locations / attendance)
  geofenceRadius Int     @default(15) // Radius in meters for clock-in zone
  timezone       String  @default("Europe/Berlin") // IANA timezone (e.g. "America/New_York")
  isActive       Boolean @default(true)
  isDefault      Boolean @default(false) // The org's default space (holds otherwise-unassigned tasks)
  isRemote       Boolean @default(false) // The org's "Remote" bucket for WFH clock-ins (no coords, geofence-exempt, hidden from pickers)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Space configuration
  enabledModules Json? // Override org modules for this space, e.g. ["time_tracking", "sprints"]
  workflowId     String?
  workflow       StatusWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  // Tasks linked to this space
  tasks Task[]

  // Recurring task templates that generate into this space
  recurringTemplates RecurringTaskTemplate[]

  // Technicians assigned to this location
  assignments TechnicianAssignment[]

  // Time entries at this location
  timeEntries TimeEntry[]

  // Overtime requests at this location
  overtimeRequests OvertimeRequest[]

  @@index([organizationId])
  @@index([isActive])
  @@map("company_locations")
}

// Technician assignment to company location (many-to-many)
model TechnicianAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isPrimary Boolean  @default(false) // Main work location
  schedule  String[] @default([]) // Work days: ["MON", "TUE", "WED", "THU", "FRI"]

  effectiveFrom DateTime  @default(now()) // Assignment start date
  effectiveTo   DateTime? // Assignment end date (null = indefinite)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, locationId]) // One assignment per user-location pair
  @@index([userId])
  @@index([locationId])
  @@map("technician_assignments")
}

// Per-employee notification routing override: a manager/admin (watcher) is
// subscribed to notifications ABOUT a specific employee (subject). When a
// subject has ANY watchers, they replace the default space/admin routing.
model NotificationWatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subjectUserId String
  subject       User   @relation("WatchSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  watcherUserId String
  watcher       User   @relation("WatchWatcher", fields: [watcherUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subjectUserId, watcherUserId])
  @@index([subjectUserId])
  @@index([watcherUserId])
  @@index([organizationId])
  @@map("notification_watches")
}

// Time entry for attendance tracking (clock-in/clock-out records)
model TimeEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id])

  status TimeEntryStatus @default(CLOCKED_IN)

  // Clock in data
  clockInAt       DateTime @default(now())
  clockInLat      Float
  clockInLng      Float
  clockInAccuracy Float?

  // Clock out data (null until clocked out)
  clockOutAt       DateTime?
  clockOutLat      Float?
  clockOutLng      Float?
  clockOutAccuracy Float?

  // Geofence validation results
  clockInWithinGeofence  Boolean  @default(true)
  clockOutWithinGeofence Boolean?

  // Remote work (WFH/anywhere): geofence-exempt, coarse place captured from GPS
  isRemote      Boolean @default(false)
  clockInPlace  String? // Coarse reverse-geocoded place, e.g. "Vienna, AT"
  clockOutPlace String?

  // Calculated duration (set on clock-out)
  totalMinutes Int?

  // Break duration (calculated from breaks)
  breakMinutes Int @default(0)

  notes String?

  // Smart auto-approval
  flagReasons    String[]       @default([]) // e.g. ["OVERTIME", "LATE_ARRIVAL"]
  approvalStatus ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?          @relation("ApprovedTimeEntries", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNotes  String?

  // Edit tracking
  isEdited         Boolean   @default(false)
  editedById       String?
  editedBy         User?     @relation("EditedTimeEntries", fields: [editedById], references: [id])
  editedAt         DateTime?
  originalClockIn  DateTime? // Original value before edit
  originalClockOut DateTime? // Original value before edit
  editReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Breaks taken during this shift
  breaks Break[]

  // Overtime extension
  overtimeRequest OvertimeRequest?

  @@index([userId, clockInAt])
  @@index([locationId])
  @@index([locationId, clockInAt]) // per-location attendance by day
  @@index([organizationId])
  @@index([status])
  @@index([approvalStatus])
  @@index([userId, status]) // check active clock-in
  @@index([organizationId, clockInAt]) // org attendance reports
  @@map("time_entries")
}

// Break records for time entries
model Break {
  id String @id @default(cuid())

  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  type BreakType @default(SHORT)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Duration in minutes (calculated on end)
  durationMinutes Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeEntryId])
  @@index([startedAt])
  @@map("breaks")
}

// ==================== AVAILABILITY & SCHEDULING ====================

// Technician recurring weekly schedule (e.g., "Monday 9:00-17:00")
model TechnicianSchedule {
  id String @id @default(cuid())

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String // "09:00" (24h format)
  endTime   String // "17:00" (24h format)
  isActive  Boolean @default(true)

  // Optional: schedule can be location-specific
  notes String? // Optional note (e.g., "Remote day")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each technician can only have one schedule entry per day
  @@unique([technicianId, dayOfWeek])
  @@index([technicianId])
  @@index([dayOfWeek, isActive])
  @@map("technician_schedules")
}

// Reusable schedule template (e.g., "Morning Shift", "Night Shift")
model ScheduleTemplate {
  id             String       @id @default(cuid())
  name           String // "Morning Shift", "Night Shift", "Flex 4x10"
  description    String?
  entries        Json // Array of { dayOfWeek, startTime, endTime, isActive, notes? }
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("schedule_templates")
}

// Time-off request (vacation, sick day, personal leave)
model TimeOff {
  id String @id @default(cuid())

  technicianId String
  technician   User   @relation("TechnicianTimeOff", fields: [technicianId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date // First day of time off
  endDate   DateTime @db.Date // Last day of time off (inclusive)
  reason    String? // "Vacation", "Sick leave", "Personal", etc.

  status TimeOffStatus @default(PENDING)

  // Approval workflow
  approvedById    String?
  approvedBy      User?     @relation("TimeOffApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String? // If rejected, reason why

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([approvedById])
  @@map("time_off_requests")
}

// ==================== INVITATION SYSTEM ====================

// Invitation for users to join an organization with a pre-assigned role
model Invitation {
  id String @id @default(cuid())

  // Short code (plaintext for display + SHA-256 hash for validation)
  code     String?
  codeHash String  @unique

  // Target role and organization
  targetRole     Role
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Custom role assignment (optional — overrides targetRole permissions)
  targetOrgRoleId String?
  targetOrgRole   OrgRole? @relation(fields: [targetOrgRoleId], references: [id], onDelete: SetNull)

  // Technician-specific fields (only used when targetRole = TECHNICIAN)
  position          String?
  scheduleType      String? // NONE | FIXED | FLEXIBLE — applied to the user on accept
  schedule          Json? // Weekly rows when FIXED: [{dayOfWeek,startTime,endTime,isActive}]
  monthlyHourBudget Int? // When FLEXIBLE
  enabledModules    Json?
  specialty         String?
  maxDailyJobs      Int?

  // Pre-assigned space (CompanyLocation id) — the accepting user is assigned to it.
  spaceId String?

  // Status tracking
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?

  // Who accepted the invitation (null until accepted)
  acceptedById String?

  // Who created the invitation
  createdById String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([expiresAt])
  @@index([organizationId, status])
  @@map("invitations")
}

// ==================== JOIN REQUEST SYSTEM ====================

// Request from an orphan user to join an organization
model JoinRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  message String? // Optional message from the requesting user

  status JoinRequestStatus @default(PENDING)

  // Review fields (set when admin approves/rejects)
  reviewedById    String?
  reviewedBy      User?     @relation("JoinRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  // Role assignment (set by admin on approval)
  assignedRole     Role?
  assignedPlatform Platform?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, organizationId, status])
  @@index([organizationId, status])
  @@index([userId])
  @@index([reviewedById])
  @@map("join_requests")
}

// ==================== MONITORING MODELS ====================

// Activity log for audit trail
model ActivityLog {
  id        String @id @default(cuid())
  // Free-form action string (e.g. "USER_LOGIN", "MEMBER_ROLE_CHANGED",
  // "TASK_DELETED", "LOCATIONS_UPDATED") so any mutation can be audited without
  // an enum migration. The gateway audit interceptor writes these.
  eventType String

  // Who performed the action
  userId String?
  user   User?   @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  // Who was affected (e.g., user being assigned, deleted)
  targetUserId String?
  targetUser   User?   @relation("ActivityLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Resource context
  resourceType String? // "task", "user", "report", "timeEntry", etc.
  resourceId   String?

  // Additional context
  metadata  Json? // { previousStatus, newStatus, reason, etc. }
  ipAddress String?
  userAgent String?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([resourceType, resourceId])
  @@map("activity_logs")
}

// System health metrics (time-series data)
model HealthMetric {
  id          String   @id @default(cuid())
  serviceName String // "gateway", "auth-service", "task-service", etc.
  metricType  String // "latency", "error_rate", "request_count", "memory_usage"
  value       Float
  timestamp   DateTime @default(now())
  metadata    Json? // { endpoint, statusCode, errorMessage, etc. }

  @@index([serviceName, timestamp])
  @@index([metricType, timestamp])
  @@map("health_metrics")
}

// Notification delivery tracking
model NotificationDelivery {
  id      String              @id @default(cuid())
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  // Recipient
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Event that triggered the notification
  eventType String // "task.assigned", "task.completed", "alert.raised", etc.
  payload   Json? // The notification content/data

  // Delivery tracking
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?
  retryCount    Int       @default(0)

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([recipientId, createdAt])
  @@index([channel, status])
  @@index([eventType])
  @@map("notification_deliveries")
}

// Real-time alerts
model Alert {
  id       String        @id @default(cuid())
  type     String // "technician_offline", "task_overdue", "geofence_violation", "high_error_rate"
  severity AlertSeverity @default(WARNING)
  status   AlertStatus   @default(ACTIVE)

  // Alert content
  title    String
  message  String
  metadata Json? // { technicianName, taskId, lastSeen, overdueBy, etc. }

  // Related entities (optional)
  userId String? // Related user (e.g., offline technician)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskId String? // Related task

  // Lifecycle tracking
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([severity, status])
  @@index([type, createdAt])
  @@index([userId])
  @@map("alerts")
}

// Daily aggregated metrics for reports (computed nightly)
model DailyMetric {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Task metrics
  tasksCreated      Int    @default(0)
  tasksCompleted    Int    @default(0)
  tasksCanceled     Int    @default(0)
  tasksOverdue      Int    @default(0)
  avgCompletionTime Float? // Average time to complete tasks (in minutes)

  // User metrics
  activeUsers      Int @default(0)
  loginCount       Int @default(0)
  failedLoginCount Int @default(0)

  // Attendance metrics
  clockInCount       Int    @default(0)
  avgWorkHours       Float? // Average hours worked
  geofenceViolations Int    @default(0)

  // Notification metrics
  emailsSent   Int @default(0)
  emailsFailed Int @default(0)
  pushSent     Int @default(0)
  pushFailed   Int @default(0)

  // Alert metrics
  alertsRaised   Int @default(0)
  alertsResolved Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, organizationId])
  @@index([organizationId, date])
  @@map("daily_metrics")
}

// Overtime request when technician's shift ends
model OvertimeRequest {
  id String @id @default(cuid())

  // Who is requesting overtime
  technicianId String
  technician   User   @relation("TechnicianOvertime", fields: [technicianId], references: [id], onDelete: Cascade)

  // Which time entry this overtime extends
  timeEntryId String    @unique
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  // Which location
  locationId String
  location   CompanyLocation @relation(fields: [locationId], references: [id])

  // Status tracking
  status OvertimeRequestStatus @default(PENDING_TECHNICIAN)

  // Technician response
  technicianRespondedAt DateTime?
  technicianReason      String? // Why tech needs overtime

  // Approval details
  approvalMethod  OvertimeApprovalMethod?
  approvedById    String?
  approvedBy      User?                   @relation("OvertimeApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approverNotes   String?

  // Signature (Path B - team leader signs on tech's phone)
  leaderName      String?
  leaderSignature String? @db.Text // base64 PNG

  // Overtime parameters
  maxDurationMinutes Int? // Max overtime allowed (set by leader)
  overtimeStartAt    DateTime? // When overtime period began
  overtimeEndAt      DateTime? // When overtime should end (scheduled)
  actualEndAt        DateTime? // When overtime actually ended

  // Calculated
  overtimeMinutes Int? // Actual overtime worked

  // Timeout tracking
  technicianTimeoutAt DateTime? // When 15-min window expires
  approvalTimeoutAt   DateTime? // When 10-min approval window expires

  // Organization scope
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId, status])
  @@index([organizationId, status])
  @@index([timeEntryId])
  @@index([status, technicianTimeoutAt])
  @@index([status, approvalTimeoutAt])
  @@map("overtime_requests")
}

// ==================== PROJECT MANAGEMENT ====================

// Phase or milestone for grouping tasks
model Phase {
  id             String       @id @default(cuid())
  name           String
  description    String?
  color          String       @default("#3b82f6")
  type           String       @default("phase") // "phase" or "milestone"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime?
  endDate        DateTime?
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          Task[]

  @@index([organizationId])
  @@map("phases")
}

// Sprint for agile workflow
model Sprint {
  id             String        @id @default(cuid())
  name           String
  goal           String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  status         SprintStatus  @default(PLANNING)
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tasks          Task[]
  report         SprintReport?

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("sprints")
}

// Epic for grouping tasks into larger initiatives
model Epic {
  id             String       @id @default(cuid())
  name           String
  description    String?
  color          String       @default("#8b5cf6")
  status         String       @default("OPEN") // OPEN, IN_PROGRESS, DONE
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime?
  targetDate     DateTime?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          Task[]

  @@index([organizationId])
  @@map("epics")
}

// Sprint report generated when a sprint completes
model SprintReport {
  id                String   @id @default(cuid())
  sprintId          String   @unique
  sprint            Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  organizationId    String
  committedPoints   Int      @default(0)
  completedPoints   Int      @default(0)
  committedTasks    Int      @default(0)
  completedTasks    Int      @default(0)
  carriedOverTasks  Int      @default(0)
  carriedOverPoints Int      @default(0)
  addedMidSprint    Int      @default(0)
  removedMidSprint  Int      @default(0)
  velocity          Float    @default(0) // completedPoints
  dailyBurndown     Json // array of { date: string, remaining: number, ideal: number }
  createdAt         DateTime @default(now())

  @@index([organizationId])
  @@map("sprint_reports")
}

// Definition of Done for organization quality gates
model DefinitionOfDone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String? // optional: tied to specific workflow
  items          Json // array of { text: string, isRequired: boolean }
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("definition_of_done")
}

// Task dependency (predecessor/successor relationship)
model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  predecessor   Task           @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     Task           @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType @default(FINISH_TO_START)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now())

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
  @@map("task_dependencies")
}

// ==================== CUSTOM STATUS WORKFLOWS ====================

// Organization-level custom status workflow
model StatusWorkflow {
  id                 String                  @id @default(cuid())
  organizationId     String
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String // "Default", "Field Service", "Logistics", etc.
  isDefault          Boolean                 @default(false)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  statuses           WorkflowStatus[]
  tasks              Task[]
  spaces             CompanyLocation[]
  customFields       CustomFieldDefinition[]
  recurringTemplates RecurringTaskTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("status_workflows")
}

// Individual status within a workflow
model WorkflowStatus {
  id           String         @id @default(cuid())
  workflowId   String
  workflow     StatusWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name         String // "New", "In Transit", "Delivered", etc.
  key          String // "NEW", "IN_TRANSIT", "DELIVERED" — machine-readable
  color        String         @default("#3b82f6")
  icon         String? // optional lucide icon name
  position     Int            @default(0)
  isFinal      Boolean        @default(false) // marks completion states
  isCanceled   Boolean        @default(false) // marks cancellation states
  transitions  String[] // array of WorkflowStatus keys this status can transition TO
  capabilities String[]       @default([]) // execution widgets active at this step (gps, timer, …)
  createdAt    DateTime       @default(now())

  @@unique([workflowId, key])
  @@index([workflowId])
  @@map("workflow_statuses")
}

// ==================== CUSTOM FIELDS ====================

// Organization-level custom field definition
model CustomFieldDefinition {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Scope: a field belongs to a Task Type (workflowId) OR is global (null → all tasks).
  // A task collects its type's fields + the global fields (cascade, like workflows).
  workflowId     String?
  workflow       StatusWorkflow?    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name           String // "Customer PO Number", "Equipment Model"
  key            String // "customer_po", "equipment_model"
  type           CustomFieldType
  options        Json? // for DROPDOWN: ["Option A", "Option B"]
  isRequired     Boolean            @default(false)
  position       Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  values         CustomFieldValue[]

  @@unique([organizationId, workflowId, key])
  @@index([organizationId])
  @@index([workflowId])
  @@map("custom_field_definitions")
}

// Custom field value for a specific task
model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  value        String // stored as string, parsed by type
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

// ==================== RECURRING TASKS ====================

// Template for automatically creating recurring tasks
model RecurringTaskTemplate {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Generated tasks land in this space and carry this Task Type, so they fit the
  // space-centric / type-driven model (not orphaned, org-level generic tasks).
  spaceId         String?
  space           CompanyLocation?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  workflowId      String?
  workflow        StatusWorkflow?     @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  priority        TaskPriority        @default(MEDIUM)
  locationLat     Float?
  locationLng     Float?
  locationAddress String?
  assigneeIds     Json? // array of user IDs to assign
  estimatedHours  Float?
  checklist       Json? // array of { text: string }
  frequency       RecurrenceFrequency
  customDays      Int? // for CUSTOM: every N days
  dayOfWeek       Int? // for WEEKLY/BIWEEKLY: 0=Sun, 1=Mon, etc.
  dayOfMonth      Int? // for MONTHLY: 1-31
  startDate       DateTime
  endDate         DateTime? // null = forever
  lastGeneratedAt DateTime?
  nextRunAt       DateTime?
  isActive        Boolean             @default(true)
  createdById     String
  createdBy       User                @relation("RecurringTaskCreator", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([nextRunAt, isActive])
  @@index([spaceId])
  @@index([workflowId])
  @@map("recurring_task_templates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVOICING & BILLING
// ═══════════════════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String // Auto-generated: INV-YYYY-XXXX
  status        InvoiceStatus @default(DRAFT)

  // Client info
  clientName    String
  clientEmail   String?
  clientAddress String?

  // Amounts
  subtotal  Float  @default(0)
  taxRate   Float? // e.g., 0.15 for 15%
  taxAmount Float  @default(0)
  discount  Float  @default(0)
  total     Float  @default(0)
  currency  String @default("USD")

  // Dates
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  // Notes
  notes String?

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("InvoiceCreator", fields: [createdById], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber]) // backstop: no duplicate invoice numbers per org
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  amount      Float  @default(0)

  // Optional link to task/service report
  taskId   String?
  reportId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ═══════════════════════════════════════════════════════════════════════════
//  IN-APP SUPPORT (tickets + conversation backbone)
//  Every support channel (web widget, mobile, email, live chat) writes to a
//  SupportTicket. Agents are platform staff (operator-key auth), so agent ids
//  are plain strings — NOT User FKs. Author of a message is disambiguated by
//  authorType, not a relation.
// ═══════════════════════════════════════════════════════════════════════════

enum SupportStatus {
  OPEN // new, awaiting first agent reply
  PENDING_AGENT // customer replied last — our turn
  PENDING_CUSTOMER // agent replied last — customer's turn
  RESOLVED // agent marked solved (customer may reopen)
  CLOSED // archived
}

enum SupportCategory {
  BILLING
  TECHNICAL
  HOWTO
  FEEDBACK
  OTHER
}

enum SupportChannel {
  WEB
  MOBILE
  EMAIL
  LIVE_CHAT
}

enum SupportAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("SupportCreatedBy", fields: [createdById], references: [id])

  subject  String
  category SupportCategory @default(OTHER)
  channel  SupportChannel  @default(WEB)
  status   SupportStatus   @default(OPEN)

  // Priority routing: lower = served first. Snapshot of the tier at creation.
  priority           Int     @default(4)
  planTierAtCreation String?

  // Agent (platform staff) currently owning the ticket — plain id, not a User FK.
  assignedAgentId String?

  // SLA (first response). Due date computed from tier's business-hours SLA.
  slaFirstResponseDueAt DateTime?
  firstRespondedAt      DateTime?
  slaBreached           Boolean   @default(false)

  lastCustomerMessageAt DateTime?
  lastAgentMessageAt    DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status]) // org-scoped ticket queries
  @@index([createdById, updatedAt]) // a customer's own ticket list (owner-scoped)
  @@index([status, priority, createdAt]) // agent inbox (priority routing order)
  @@index([assignedAgentId, status]) // an agent's assigned view
  @@index([slaBreached, slaFirstResponseDueAt]) // breach sweep / at-risk
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Author id: a User id for CUSTOMER, an agent handle for AGENT, null for SYSTEM.
  authorId       String?
  authorType     SupportAuthorType
  body           String
  attachments    Json              @default("[]") // SupportAttachment[]
  isInternalNote Boolean           @default(false) // agent-only; never delivered to the customer

  readByCustomerAt DateTime?
  readByAgentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MEMBER-TO-MEMBER CHAT (1:1 DMs now; GROUP later)
// ═══════════════════════════════════════════════════════════════════════════

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ConversationType @default(DIRECT)
  title          String? // group name; DMs derive title from the other member
  // Stable key for a 1:1 thread (sorted userIds) so two people share ONE
  // conversation. Null for GROUP (multiple nulls are allowed by the unique idx).
  dmKey          String?
  createdById    String
  lastMessageAt  DateTime?

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dmKey]) // one DM per pair per org
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("ChatMessageSender", fields: [senderId], references: [id])
  body           String
  attachments    Json         @default("[]") // ChatAttachment[]
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
//  SaaS BILLING & SUBSCRIPTIONS
//  (org-level subscription state; distinct from the customer-facing Invoice
//   model above, which is orgs billing THEIR OWN clients for jobs.)
// ═══════════════════════════════════════════════════════════════════════════

enum PlanTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING // in 14-day free trial (no card yet)
  ACTIVE // paid & current
  PAST_DUE // payment failed, in dunning grace period
  CANCELED // canceled (access until currentPeriodEnd, then locked)
  INCOMPLETE // trial ended with no payment method → locked read-only
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// One subscription per organization. Seat quantities are derived from member
/// access (office = ADMIN + web members, field = mobile-only) and synced to Stripe.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String?            @unique
  planTier             PlanTier
  status               SubscriptionStatus @default(TRIALING)
  interval             BillingInterval    @default(MONTHLY)

  officeSeats Int @default(0)
  fieldSeats  Int @default(0)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

/// Raw Stripe webhook events — for idempotency (unique stripeEventId) and audit.
model BillingEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  stripeEventId String    @unique
  type          String
  payload       Json?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@map("billing_events")
}
