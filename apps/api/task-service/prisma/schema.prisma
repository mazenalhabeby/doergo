generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  CLIENT      // Was: PARTNER - Creates tasks (external customer)
  DISPATCHER  // Was: OFFICE - Assigns workers, monitors operations
  TECHNICIAN  // Was: WORKER - Executes tasks in the field
}

// Access level for organization delegation
enum AccessLevel {
  NONE           // No access - manager sees nothing
  TASKS_ONLY     // Can view tasks only
  TASKS_ASSIGN   // Can view tasks + assign workers
  FULL           // Can view everything + assign
}

enum TaskStatus {
  DRAFT
  NEW
  ASSIGNED
  ACCEPTED     // Technician acknowledges the assigned task
  EN_ROUTE     // Technician is traveling to the job location
  ARRIVED      // Technician has arrived at the location
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELED
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_TOGGLED
  CHECKLIST_ITEM_REMOVED
}

enum TaskAssigneeRole {
  LEAD
  MEMBER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
  EMAIL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  OTHER
}

// Models
model Organization {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  tasks Task[]

  // Organization delegation relationships
  grantedAccess  OrganizationAccess[] @relation("Grantor")  // Access this org has granted to others
  receivedAccess OrganizationAccess[] @relation("Grantee")  // Access this org has received from others

  // Custom workflows & fields
  workflows              StatusWorkflow[]
  customFieldDefinitions CustomFieldDefinition[]
  recurringTemplates     RecurringTaskTemplate[]

  @@map("organizations")
}

// Many-to-many delegation: Org A can manage Org B (if B grants access)
model OrganizationAccess {
  id String @id @default(cuid())

  // Who is granting access (the managed org)
  grantorOrgId String
  grantorOrg   Organization @relation("Grantor", fields: [grantorOrgId], references: [id], onDelete: Cascade)

  // Who is receiving access (the manager org)
  granteeOrgId String
  granteeOrg   Organization @relation("Grantee", fields: [granteeOrgId], references: [id], onDelete: Cascade)

  // Access level
  accessLevel AccessLevel @default(NONE)

  // Granular permissions (for fine-tuned control)
  canViewTasks     Boolean @default(false)
  canAssignWorkers Boolean @default(false)
  canViewWorkers   Boolean @default(false)
  canViewTracking  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each org pair can only have one access record
  @@unique([grantorOrgId, granteeOrgId])
  @@index([grantorOrgId])
  @@index([granteeOrgId])
  @@map("organization_access")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Security: Account lockout fields
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdTasks   Task[]       @relation("TaskCreator")
  assignedTasks  Task[]       @relation("TaskAssignee")
  taskAssignments TaskAssignee[] @relation("TaskAssignees")
  comments       Comment[]
  attachments    Attachment[]
  taskEvents     TaskEvent[]
  lastLocation         WorkerLastLocation?
  locationHistory      LocationHistory[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  recurringTemplates   RecurringTaskTemplate[] @relation("RecurringTaskCreator")

  @@index([organizationId])
  @@index([role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // Store SHA-256 hash, not plain token
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Grace period fields for handling concurrent refresh requests
  usedAt               DateTime?  // When the token was first used (null = not used yet)
  replacedByTokenHash  String?    // Hash of the new token that replaced this one
  cachedAccessToken    String?    // Cached access token to return during grace period
  cachedRefreshToken   String?    // Cached refresh token to return during grace period (temporary, deleted after grace period)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([usedAt])  // For cleanup of old used tokens
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique  // Store SHA-256 hash, not plain token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      String       @default("NEW")
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  startDate       DateTime?
  estimatedHours  Float?

  // Custom workflow association
  workflowId  String?
  workflow    StatusWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  locationLat     Float?
  locationLng     Float?
  locationAddress String?

  // Route tracking fields
  routeStartedAt DateTime?  // When EN_ROUTE started
  routeEndedAt   DateTime?  // When ARRIVED
  routeDistance  Float?     // Total distance in meters

  // Subtask hierarchy
  parentId    String?
  parent      Task?     @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]    @relation("TaskSubtasks")
  depth       Int       @default(0)
  position    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  comments        Comment[]
  attachments     Attachment[]
  events          TaskEvent[]
  locationHistory LocationHistory[]
  assignees       TaskAssignee[]
  checklistItems  ChecklistItem[]
  customFields    CustomFieldValue[]

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([workflowId])
  @@index([parentId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Attachment {
  id        String         @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  AttachmentType
  fileSize  Int
  createdAt DateTime       @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

model TaskEvent {
  id        String        @id @default(cuid())
  eventType TaskEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([eventType])
  @@index([createdAt])
  @@map("task_events")
}

model WorkerLastLocation {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_last_locations")
}

// Location history for route tracking during EN_ROUTE status
model LocationHistory {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  accuracy  Float?
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([taskId, timestamp])
  @@map("location_history")
}

model TaskAssignee {
  id        String           @id @default(cuid())
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("TaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  role      TaskAssigneeRole @default(MEMBER)
  createdAt DateTime         @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text        String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([taskId, position])
  @@map("checklist_items")
}

// ==================== CUSTOM STATUS WORKFLOWS ====================

model StatusWorkflow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  statuses       WorkflowStatus[]
  tasks          Task[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("status_workflows")
}

model WorkflowStatus {
  id         String         @id @default(cuid())
  workflowId String
  workflow   StatusWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  key        String
  color      String         @default("#3b82f6")
  icon       String?
  position   Int            @default(0)
  isFinal    Boolean        @default(false)
  isCanceled Boolean        @default(false)
  transitions String[]
  createdAt  DateTime       @default(now())

  @@unique([workflowId, key])
  @@index([workflowId])
  @@map("workflow_statuses")
}

// ==================== CUSTOM FIELDS ====================

model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  type           CustomFieldType
  options        Json?
  isRequired     Boolean         @default(false)
  position       Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  values         CustomFieldValue[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  value        String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

// ==================== RECURRING TASKS ====================

model RecurringTaskTemplate {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  priority       TaskPriority        @default(MEDIUM)
  locationLat    Float?
  locationLng    Float?
  locationAddress String?
  assigneeIds    Json?
  estimatedHours Float?
  checklist      Json?
  frequency      RecurrenceFrequency
  customDays     Int?
  dayOfWeek      Int?
  dayOfMonth     Int?
  startDate      DateTime
  endDate        DateTime?
  lastGeneratedAt DateTime?
  nextRunAt      DateTime?
  isActive       Boolean             @default(true)
  createdById    String
  createdBy      User                @relation("RecurringTaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([nextRunAt, isActive])
  @@map("recurring_task_templates")
}
