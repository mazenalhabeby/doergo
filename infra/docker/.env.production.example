# ═══════════════════════════════════════════════════════════════════════════════
# HBCField Production Environment Variables
# Copy this file to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=hbcfield
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=hbcfield

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ─── JWT Secrets (minimum 64 characters each, use: openssl rand -hex 64) ──────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── CORS (comma-separated allowed origins) ───────────────────────────────────
CORS_ORIGINS=https://yourdomain.com

# ─── Bull Board Admin (password required in production) ────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=CHANGE_ME_BULL_BOARD_PASSWORD

# ─── S3 / Object Storage ──────────────────────────────────────────────────────
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=hbcfield
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ─── SMTP (Email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=HBCField <noreply@yourdomain.com>

# ─── Web App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://ws.yourdomain.com

# ─── Ports (exposed to host) ──────────────────────────────────────────────────
GATEWAY_PORT=4000
NOTIFICATION_PORT=4001
WEB_PORT=3000

# ── Map tiles (web) ──────────────────────────────────────────────────────────
# Baked into the web image at BUILD time (NEXT_PUBLIC_*), so changing these
# needs a rebuild of the web container, not just a restart.
#
# Leave empty and the maps fall back to OpenStreetMap's public tile servers.
# That is correct for a developer's machine and NOT permitted for production
# traffic by their Tile Usage Policy — set both here before going live.
#
# The attribution is a licence condition of whichever host you use (the data is
# ODbL), so it has to match the provider, not be left on OSM's wording.
#
# MapTiler example — restrict the key to your origins in their dashboard:
#   MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# ── Geocoding ────────────────────────────────────────────────────────────────
# Google serves BOTH: Places API for address search, Geocoding API for reverse.
# Both must be enabled on the key or reverse geocoding silently returns nothing.
GOOGLE_PLACES_API_KEY=
#
# Self-hosted Photon. OPTIONAL — leave empty unless a Photon container is
# actually running (see docker-compose.photon.yml). Empty means Google is the
# only geocoder, which is worldwide and already the primary.
PHOTON_URL=
#
# Route optimizer (CRM). OPTIONAL — empty means stops are ordered by
# nearest-neighbour rather than real road distances. Never point this at the
# public OSRM demo host: its own policy excludes production use.
OSRM_URL=
