# ==================== DOMAIN ====================
DOMAIN=doergo.hbc-solution.io
# Change to https after setting up SSL certificates
PROTOCOL=http

# ==================== DATABASE ====================
POSTGRES_USER=doergo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=doergo

# ==================== JWT SECRETS ====================
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_DIFFERENT

# Token expiration
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=24h

# ==================== S3 STORAGE ====================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=doergo
S3_REGION=eu-central-1

# ==================== SMTP ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@doergo.com

# ==================== SOCKET.IO ADMIN ====================
SOCKET_ADMIN_USER=
SOCKET_ADMIN_PASSWORD=
