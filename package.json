{
  "name": "hbcfield",
  "version": "1.0.0",
  "private": true,
  "description": "HBCField - 3-role task management and field execution platform (Microservices)",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "socket.io-parser": ">=4.2.7",
      "path-to-regexp": ">=8.4.0",
      "effect": ">=3.20.0",
      "@nestjs/platform-express": "~11.2.7",
      "@nestjs/websockets": "~11.2.7",
      "@nestjs/platform-socket.io": "~11.2.7",
      "undici@>=6.0.0 <6.28.0": "^6.28.0",
      "node-forge@<1.4.0": "^1.4.0",
      "lodash@<4.18.0": "^4.18.0",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "tar@>=7.0.0 <7.5.21": "^7.5.21",
      "shell-quote@<1.9.0": "^1.9.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "defu@<6.1.5": "^6.1.5",
      "browserslist@<4.28.7": "^4.28.7",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "engine.io@>=6.0.0 <6.6.7": "^6.6.7",
      "ws@>=6.0.0 <6.2.4": "^6.2.4",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "multer@<2.3.0": "^2.3.0",
      "compression@<1.8.2": "^1.8.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "fast-xml-parser@>=5.0.0 <5.7.0": "^5.7.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "dompurify@>=3.0.0 <3.4.16": "^3.4.16",
      "postcss-selector-parser@>=6.0.0 <6.1.3": "^6.1.3",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "handlebars@>=4.0.0 <4.7.10": "^4.7.10",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "flatted@<3.4.2": "^3.4.2",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "decode-uri-component@<0.5.0": "0.5.0",
      "fflate@>=0.6.0 <0.6.11": "^0.8.3",
      "deepmerge-ts@<8.0.0": "^8.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    },
    "patchedDependencies": {
      "react-native-draggable-flatlist@4.0.3": "patches/react-native-draggable-flatlist@4.0.3.patch",
      "expo-mlkit-ocr@0.2.7": "patches/expo-mlkit-ocr@0.2.7.patch"
    },
    "allowNonAppliedPatches": true
  },
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:api": "pnpm --filter \"@hbcfield/*-service\" --filter @hbcfield/api-gateway run --parallel dev",
    "dev:gateway": "pnpm --filter @hbcfield/api-gateway dev",
    "dev:auth": "pnpm --filter @hbcfield/auth-service dev",
    "dev:task": "pnpm --filter @hbcfield/task-service dev",
    "dev:notification": "pnpm --filter @hbcfield/notification-service dev",
    "dev:tracking": "pnpm --filter @hbcfield/tracking-service dev",
    "dev:web-app": "pnpm --filter @hbcfield/web-app dev",
    "dev:mobile": "pnpm --filter @hbcfield/mobile start",
    "build": "pnpm run --parallel build",
    "build:api": "pnpm --filter \"@hbcfield/*-service\" --filter @hbcfield/api-gateway run --parallel build",
    "build:web": "pnpm --filter \"@hbcfield/web-*\" run --parallel build",
    "lint": "pnpm run --parallel lint",
    "i18n:check": "node tools/i18n/check-slot-widths.mjs",
    "test": "pnpm run --parallel test",
    "db:generate": "pnpm --filter @hbcfield/auth-service prisma:generate",
    "db:migrate": "pnpm --filter @hbcfield/auth-service prisma:migrate",
    "db:seed": "pnpm --filter @hbcfield/auth-service prisma:seed",
    "db:studio": "pnpm --filter @hbcfield/auth-service prisma:studio",
    "docker:dev": "docker-compose -f infra/docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f infra/docker/docker-compose.dev.yml down",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infra/docker/docker-compose.yml logs -f",
    "clean": "rm -rf node_modules apps/*/node_modules apps/api/*/node_modules packages/*/node_modules",
    "db:create-fresh": "pnpm --filter @hbcfield/auth-service db:create-fresh",
    "size:check": "node tools/size-ratchet.mjs",
    "size:update": "node tools/size-ratchet.mjs --update",
    "structure:check": "node tools/structure-check.mjs",
    "structure:update": "node tools/structure-check.mjs --update",
    "structure:report": "node tools/structure-check.mjs --report",
    "dry:check": "node tools/dry-check.mjs",
    "dry:update": "node tools/dry-check.mjs --update",
    "rpc:check": "node tools/rpc-ratchet.mjs",
    "format:changed": "node tools/format-changed.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.39.4",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.57.0"
  }
}
